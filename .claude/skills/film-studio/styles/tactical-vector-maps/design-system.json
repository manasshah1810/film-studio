      "tier": 0,
      "name": "sea",
      "role": "bg",
      "use": "the ocean, the whole frame"
    },
    {
      "tier": 1,
      "name": "shelf",
      "role": "bg to surface 35 percent",
      "use": "a wide soft band around every coast"
    },
    {
      "tier": 2,
      "name": "lowland",
      "role": "surface",
      "use": "the outer band of a landmass"
    },
    {
      "tier": 3,
      "name": "highland",
      "role": "surface plus ink 10 percent",
      "use": "the middle band"
    },
    {
      "tier": 4,
      "name": "ridge",
      "role": "surface plus ink 20 percent",
      "use": "the core of a landmass"
    },
    {
      "tier": 5,
      "name": "overlay",
      "role": "primary, highlight, alert, ink",
      "use": "routes, beacons, pins, stamps; always above every land tier"
    }
