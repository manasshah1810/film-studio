  "numerals": {
    "tabular": true,
    "css": "font-variant-numeric: tabular-nums",
    "rule": "Every number is tabular. Counters sit in fixed width digit columns."
  },
  "type_scale": {
    "hero": 132,
    "display": 108,
    "h1": 84,
    "h2": 64,
    "body": 44,
    "label": 34,
    "stamp": 56
  },
  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "card": {
      "radius": 28,
      "border": {
        "width": 2,
        "role": "ink",
        "alpha": 0.18
      }
    },
    "plate": {
      "radius": 18,
      "fill": "surface",
      "border": {
        "width": 3,
        "role": "alert"
      },
      "note": "Every label sits on an opaque plate. Text never sits on land, a grid line or a route."
    },
    "map": {
      "authoring_space": [
        1000,
        800
      ],
      "to_px": 0.8,
      "ruler": {
        "left": 120,
        "bottom": 64,
        "fill": "surface",
        "label_role": "muted"
      },
      "note": "Author landmasses in a 1000 x 800 space and draw at 0.8, so the whole map fits the view at zoom 1."
    },
    "land": {
      "shadow": {
        "dx": 0,
        "dy": 14,
        "role": "bg darkened 55 percent"
      },
      "shelf": {
        "width": 24,
        "role": "bg to surface 35 percent"
      },
      "bands": {
        "edge_depth": 14,
        "mid_depth": 34,
        "note": "Inner bands by clipped stroke: fill the ridge, stroke the highland 2 x 34, stroke the lowland 2 x 14, all clipped to the landmass. Depths scale with zoom."
      },
      "coast": {
        "width": 2,
        "role": "ink",
        "alpha": 0.35
      },
      "faction_tint": 0.22
    },
    "grid": {
      "spacing": 160,
      "role": "ink",
      "alpha": 0.12,
      "width": 2,
      "tick": 10,
      "note": "Spacing in authoring units, a cross tick at each crossing."
    },
    "route": {
      "width": 8,
      "dash": [
        30,
        18
      ],
      "march_px_per_frame": 1.4,
      "ghost": {
        "dash": [
          10,
          14
        ],
        "alpha": 0.6,
        "role": "alert"
      },
      "dead_alpha": 0.3,
      "head_radius": 12,
      "mask_width": 16
    },
    "beacon": {
      "radius": 12,
      "ping": {
        "rings": 3,
        "period": 40,
        "stagger": 13,
        "max_radius": 80,
        "width": 3,
        "alpha_curve": 1.5
      }
    },
    "pin": {
      "stem": 44,
      "badge_radius": 28,
      "badge_fill": "highlight",
      "badge_text": "bg"
    },
    "stamp": {
      "rotate": -8,
      "border": 4,
      "from_scale": 1.7,
      "role": "alert",
      "font": "accent"
    },
    "dial": {
      "ticks": 24,
      "ring_radius": 108,
      "tick_len": 16,
      "event_len": 28,
      "progress_width": 8
    }
  },
  "motion": {
    "fps": 30,
    "hold": 10,
    "enter_frames": 10,
    "stagger_frames": 6,
    "min_hold_frames": 6,
    "camera": "the map camera pans and zooms by coordinate: follow the route head, dwell on a beacon, then an elastic pull-back to the whole map",
    "easings": {
      "trace": [
        0.45,
        0,
        0.2,
        1
      ],
      "pan": [
        0.4,
        0,
        0.2,
        1
      ],
      "roll": [
        0.22,
        1,
        0.36,
        1
      ],
      "pop": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "fade": [
        0.65,
        0,
        0.35,
        1
      ]
    },
    "springs": {
      "pop": {
        "damping": 11,
        "stiffness": 190,
        "mass": 0.8
      },
      "stamp": {
        "damping": 9,
        "stiffness": 220,
        "mass": 0.9
      },
      "elastic": {
        "damping": 8,
        "stiffness": 70,
        "mass": 1
      }
    },
    "pacing": {
      "note": "A route draws in 36 to 40 frames, the camera dwells 24 to 28 frames on a beacon, and the next route starts after the camera has arrived."
    }
  },
  "composition": {
    "margin": 8,
    "align": "left",
    "anchors": [
      "title-top",
      "map-card",
      "callout-plates-rail",
      "dial-and-stat-lower"
    ],
    "safe": {
      "x": [
        8,
        85
      ],
      "y": [
        8,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "route-trace",
      "recipe": "A dashed Bezier route is revealed by a mask whose stroke draws on with a real dash length. The dashes march along the route for the rest of the film."
    },
    {
      "name": "radar-ping",
      "recipe": "Three concentric rings 13 frames apart expand from a beacon to 80 px and fade, on a 40 frame loop."
    },
    {
      "name": "coordinate-pan-zoom",
      "recipe": "One camera: a centre in map coordinates and a zoom. Every point is projected each frame, so strokes stay crisp and the grid and rulers stay true."
    },
    {
      "name": "elastic-pull-back",
      "recipe": "After the last route lands, a spring with damping 8 takes the zoom from 1.5 to 0.85 and overshoots to about 0.75 before it settles."
    },
    {
      "name": "serif-stamp",
      "recipe": "A rotated serif word on an opaque plate thuds in at 1.7 scale on the stamp spring and holds. It marks one event."
    },
    {
      "name": "day-dial",
      "recipe": "A 24 tick ring with a sweeping progress arc and a rolling day counter. Event ticks are longer and coloured."
    }
  ],
  "widgets": [
    "PictureDive",
    "LensRing",
    "OrbitRing",
    "DayDial",
    "SerifStamp"
  ],
  "forbidden": [
    "any person, flag, soldier or face",
    "text on land, on the grid or on a route",
    "a label under 4.5:1",
    "a route or beacon colour under 4.5:1 on the sea",
    "more than 2 accent colours in one map",
    "default CSS ease or linear",
    "a camera that cuts instead of panning",
    "invented geography presented as real",
    "real borders drawn without a source"
  ]
}
