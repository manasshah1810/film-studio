  "numerals": {
    "tabular": true,
    "css": "font-variant-numeric: tabular-nums",
    "rule": "Every number is tabular and set in the mono. Fixed width keeps a scrambling value from jumping."
  },
  "type_scale": {
    "hero": 132,
    "display": 108,
    "h1": 84,
    "h2": 64,
    "body": 44,
    "label": 34
  },
  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "card": {
      "radius": 10,
      "border": {
        "width": 2,
        "role": "primary",
        "alpha": 0.55
      }
    },
    "plate": {
      "radius": 8,
      "fill": "surface",
      "note": "Every readout sits on an opaque plate with a thin primary border. Text is never put on the rings, the grid or the scanlines."
    },
    "stroke": {
      "hair": 2,
      "line": 4,
      "heavy": 6,
      "note": "Three line weights only. Rings use 2 to 6, glows use none."
    },
    "grid": {
      "pitch": 60,
      "role": "grid",
      "alpha": 0.5,
      "note": "A faint square grid under the reticle. Focused palettes blend primary 14 percent into bg."
    },
    "glow": {
      "role": "primary",
      "blur": 14,
      "alpha": 0.22,
      "note": "One soft glow behind the reticle. No glow on text."
    },
    "glitch": {
      "frames": 8,
      "offset_px": 12,
      "bands": 3,
      "note": "RGB chromatic glitch: two ghost copies in primary and alert, offset in x, with horizontal slice bands."
    },
    "lock": {
      "frames": 30,
      "note": "The lock box shrinks from the outer ring to the target on a spring, then the status flips to LOCKED."
    }
  },
  "motion": {
    "fps": 30,
    "hold": 10,
    "enter_frames": 12,
    "stagger_frames": 8,
    "min_hold_frames": 6,
    "camera": "locked; the rings spin, the readouts decode, a 8 frame RGB glitch marks the lock",
    "easings": {
      "draw": [
        0.22,
        1,
        0.36,
        1
      ],
      "lock": [
        0.65,
        0,
        0.35,
        1
      ],
      "fade": [
        0.65,
        0,
        0.35,
        1
      ],
      "settle": [
        0.22,
        1,
        0.36,
        1
      ]
    },
    "springs": {
      "lock": {
        "damping": 13,
        "stiffness": 150,
        "mass": 1
      },
      "pop": {
        "damping": 11,
        "stiffness": 190,
        "mass": 0.8
      }
    },
    "pacing": {
      "note": "Brackets 12 frames, rings draw on staggered 6 frames apart, readouts decode 18 frames each staggered 8, lock at about frame 95, glitch 8 frames, hold the locked frame at least 30 frames."
    }
  },
  "composition": {
    "margin": 8,
    "align": "left",
    "anchors": [
      "title-top",
      "status-row",
      "reticle-center",
      "waveform",
      "readout-grid"
    ],
    "safe": {
      "x": [
        8,
        85
      ],
      "y": [
        8,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "text-scramble-decode",
      "recipe": "A readout shows random glyphs from a fixed charset, then locks one character at a time from the left over 18 frames. Monospace only, so the width never changes."
    },
    {
      "name": "counter-rotating-reticle-drift",
      "recipe": "Adjacent rings turn in opposite directions at different speeds (0.5, 0.9, 1.6 degrees per frame), so the reticle always looks alive and never repeats in sync."
    },
    {
      "name": "rgb-chromatic-glitch",
      "recipe": "For 8 frames two ghost copies of the reticle in primary and alert sit 12 px left and right, and three horizontal slices shift. Use once, on the lock."
    },
    {
      "name": "lock-on",
      "recipe": "The lock box shrinks from the outer ring to the target on a spring, the status flips from TRACK to LOCKED and the gauge fills."
    },
    {
      "name": "bracket-draw",
      "recipe": "Corner brackets draw from the corner outward over 12 frames using stroke-dashoffset."
    },
    {
      "name": "signal-bars",
      "recipe": "A row of bars moves with two summed sines; the tallest bar takes the highlight colour."
    }
  ],
  "widgets": [
    "OrbitRing",
    "CodeBody",
    "LensRing",
    "EyedropperGrade",
    "GridCollapse"
  ],
  "forbidden": [
    "text on the rings, grid or scanlines",
    "a proportional font for a number",
    "scanlines drawn over text",
    "a glow on text",
    "rings that all spin the same way at the same speed",
    "a label under 34 px",
    "a label under 4.5:1",
    "a hex colour in a component",
    "a photograph or a video",
    "default CSS ease or linear for the lock",
    "glitch more than once in 10 s"
  ]
}
