{
  "style": "scifi-hud",
  "version": 1,
  "subject_mode": "ui-first",
  "subject_note": "Mode C, UI and data first. The frame is an instrument: rings, brackets, waveforms and readouts. No person, no photo, no video, no network images. The one subject is the thing being tracked, drawn as a wire shape.",
  "surface_roles": [
    "bg",
    "surface"
  ],
  "text_roles": {
    "body": [
      "ink"
    ],
    "display": [
      "ink"
    ]
  },
  "hud": {
    "rings": [
      {
        "id": "ticks",
        "r": 330,
        "kind": "tick ring",
        "count": 120,
        "stroke": 12,
        "spin": "ccw slow",
        "note": "minor ticks; a second ring of 24 major ticks sits on the same radius, stroke 24"
      },
      {
        "id": "outer-arcs",
        "r": 296,
        "kind": "segmented arcs",
        "count": 6,
        "gap": 0.22,
        "stroke": 6,
        "spin": "cw 0.5 deg per frame",
        "note": "6 arcs with a 22 percent gap"
      },
      {
        "id": "gauge",
        "r": 262,
        "kind": "gauge arc",
        "stroke": 14,
        "spin": "none",
        "note": "a partial arc that fills with the signal value; the orbit dot rides this radius"
      },
      {
        "id": "fine",
        "r": 228,
        "kind": "fine dashes",
        "count": 36,
        "gap": 0.5,
        "stroke": 3,
        "spin": "ccw 0.9 deg per frame",
        "note": "36 short dashes"
      },
      {
        "id": "inner-arcs",
        "r": 190,
        "kind": "segmented arcs",
        "count": 4,
        "gap": 0.3,
        "stroke": 2,
        "spin": "cw 1.6 deg per frame",
        "note": "4 arcs, the fastest ring"
      },
      {
        "id": "lens",
        "r": 150,
        "kind": "lens ring",
        "stroke": 2,
        "spin": "none",
        "note": "a filled disc with a soft radial gradient and a thin rim"
      }
    ],
    "brackets": {
      "inset": 36,
      "arm": 110,
      "stroke": 5,
      "note": "Four corner registration brackets, drawn on in 12 frames, plus a plus mark at each edge middle."
    },
    "scanlines": {
      "pitch": 4,
      "line": 2,
      "alpha": 0.16,
      "band_h": 220,
      "band_alpha": 0.06,
      "note": "Drawn above the rings and under every plate. Never over text."
    },
    "waveform": {
      "bars": 28,
      "gap": 6,
      "note": "Live signal bars on a plate, height from two summed sines, the peak bar takes the highlight."
    },
    "readout": {
      "plate": "surface",
      "label_px": 34,
      "value_px": 44,
      "scramble": {
        "frames": 18,
        "stagger": 8,
        "charset": "0123456789ABCDEF#%/<>"
      },
      "note": "Value is a monospace string that scrambles, then locks character by character from the left."
    }
  },
  "camera": {
    "note": "A locked camera. Motion lives in the rings and the readouts; the frame itself only has a short RGB glitch."
  },
