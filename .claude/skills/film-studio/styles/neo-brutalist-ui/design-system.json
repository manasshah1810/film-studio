  "type_scale": {
    "hero": 132,
    "display": 108,
    "h1": 84,
    "h2": 64,
    "body": 44,
    "label": 34,
    "numeral": 180
  },
  "tokens": {
    "frame_scale": 3,
    "frame_scale_note": "Tokens are in design px on a 360 x 640 canvas. The 1080 x 1920 frame multiplies them by frame_scale.",
    "border": {
      "width": 3,
      "style": "solid",
      "color": "ink",
      "radius": {
        "card": 10,
        "button": 8,
        "pill": 999,
        "sticker": 6
      }
    },
    "offset_shadow": {
      "x": 5,
      "y": 5,
      "blur": 0,
      "color": "ink",
      "pressed": {
        "x": 1,
        "y": 1
      },
      "lifted": {
        "x": 8,
        "y": 8
      }
    },
    "backdrop_blur": {
      "radius": 12,
      "saturate": 1.4,
      "fill": "surface",
      "fill_alpha": 0.74,
      "border": {
        "width": 3,
        "color": "ink"
      },
      "shadow": {
        "x": 5,
        "y": 5,
        "blur": 0,
        "color": "ink"
      }
    },
    "sticker": {
      "rotate": [
        -8,
        8
      ],
      "border": 3,
      "shadow": {
        "x": 3,
        "y": 3,
        "blur": 0,
        "color": "ink"
      }
    },
    "ground": {
      "dot_pitch": 14,
      "dot_size": 1.4,
      "dot_opacity": 0.14,
      "band_rotate": -6,
      "band_role": "primary"
    }
  },
  "motion": {
    "fps": 30,
    "hold": 12,
    "enter_frames": 8,
    "stagger_frames": 5,
    "min_hold_frames": 6,
    "camera": "none; the UI moves, the frame does not. A 1.00 to 1.03 push on the workspace only.",
    "easings": {
      "snap": [
        0.2,
        0.9,
        0.2,
        1
      ],
      "overshoot": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "flip": [
        0.65,
        0,
        0.35,
        1
      ],
      "drop": [
        0.55,
        0,
        1,
        0.45
      ],
      "settle": [
        0.22,
        1,
        0.36,
        1
      ]
    },
    "springs": {
      "overshoot": {
        "damping": 12,
        "stiffness": 170,
        "mass": 0.9
      },
      "flip": {
        "damping": 16,
        "stiffness": 110,
        "mass": 1
      },
      "gravity": {
        "damping": 7,
        "stiffness": 220,
        "mass": 1.1
      },
      "press": {
        "damping": 14,
        "stiffness": 300,
        "mass": 0.7
      }
    }
  },
  "composition": {
    "margin": 8,
    "align": "left",
    "anchors": [
      "title-top",
      "workspace-centre",
      "glass-cards-lower"
    ],
    "tilt": [
      -8,
      8
    ],
    "safe": {
      "x": [
        8,
        85
      ],
      "y": [
        9,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "hard-shadow-press",
      "recipe": "A button sits on a 5 design px offset shadow. On click it moves 4 px toward the shadow and the shadow shrinks to 1 px."
    },
    {
      "name": "gravity-drop",
      "recipe": "A card falls from above the frame with the gravity spring, hits its slot, squashes 6 percent in y for 3 frames, then settles."
    },
    {
      "name": "axis-flip",
      "recipe": "A card turns on its Y axis, perspective 1400 px, 0 to 180 degrees over 18 frames; the back face is pre-rotated and hidden until 90."
    },
    {
      "name": "sticker-stamp",
      "recipe": "A rotated badge scales 1.6 to 1 with the overshoot spring and lands at -6 degrees with a 3 px hard shadow."
    },
    {
      "name": "glass-over-texture",
      "recipe": "A surface fill at 74 percent alpha with a 12 px blur sits on a dot grid and a primary band so the blur is visible and the ink text stays above 4.5:1."
    },
    {
      "name": "live-cursor",
      "recipe": "A named cursor travels on a bezier path, slows on the target, presses with the press spring, then the target reacts in the same frame."
    },
    {
      "name": "typed-prompt",
      "recipe": "A prompt types at 1 character per frame in the mono face with a block caret that blinks every 8 frames."
    },
    {
      "name": "count-up",
      "recipe": "A metric counts from 0 over 24 frames with the settle bezier and the unit stays fixed so the card never reflows."
    }
  ],
  "forbidden": [
    "soft blurred drop shadows",
    "gradient fills on cards",
    "glass text under 4.5:1",
    "a border thinner than 3 design px",
    "a card with no offset shadow",
    "more than 3 glass cards in one panel",
    "a stock arrow cursor with no name tag",
    "default CSS ease or linear",
    "placeholder copy"
  ]
}
