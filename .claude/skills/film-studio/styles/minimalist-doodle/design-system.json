  "numerals": {
    "variant": "tabular-nums",
    "note": "Counters and step numbers are fixed-length strings."
  },
  "type_scale": {
    "hero": 120,
    "display": 104,
    "h1": 76,
    "h2": 52,
    "body": 44,
    "label": 32
  },
  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "card": {
      "radius": 22,
      "pad": 20,
      "wobble": 4,
      "border": {
        "width": 6,
        "role": "ink"
      },
      "fill": "surface",
      "note": "A hand-drawn card: surface fill, a wobbly 6 px ink outline drawn on, corners about 22 px. No drop shadow, no blur."
    },
    "check": {
      "box": 40,
      "stroke": 6,
      "note": "RunningList box in ink, the tick in primary."
    },
    "arrow": {
      "stroke": 6,
      "head": 26,
      "head_deg": 28
    },
    "kicker": {
      "role": "ink"
    }
  },
  "motion": {
    "fps": 30,
    "hold": 10,
    "enter_frames": 10,
    "stagger_frames": 4,
    "min_hold_frames": 6,
    "camera": "locked; the board never moves, ink draws on, cards pop, the host acts",
    "easings": {
      "draw": [
        0.45,
        0,
        0.55,
        1
      ],
      "settle": [
        0.22,
        1,
        0.36,
        1
      ],
      "snap": [
        0.5,
        0,
        0.1,
        1
      ]
    },
    "springs": {
      "pop": {
        "damping": 10,
        "stiffness": 190,
        "mass": 0.6
      },
      "point": {
        "damping": 12,
        "stiffness": 140,
        "mass": 0.8
      }
    },
    "stepped": {
      "on": 2,
      "note": "Word wipes and pops are sampled on twos to match the 2-frame boil."
    },
    "pacing": {
      "note": "Title 6 to 34, host drawn 10 to 54, cards pop at 46, 72 and 96, arrows 58, 84 and 106, the loop closes at 118 (host reacts), the arm points at 128, markup 130 to 156, list 144 to 176, hold to 180."
    }
  },
  "composition": {
    "margin": 9,
    "align": "left",
    "anchors": [
      "kicker",
      "title",
      "diagram",
      "host",
      "list"
    ],
    "safe": {
      "x": [
        9,
        85
      ],
      "y": [
        6,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "svg-path-draw-on",
      "recipe": "pathLength 1 and dashoffset 1 - t on the draw easing, in pen order, 45 px a frame."
    },
    {
      "name": "two-frame-line-boil",
      "recipe": "feTurbulence into feDisplacementMap on the ink layer, seed held 2 frames, 3 seeds, scale 3.5."
    },
    {
      "name": "spring-pop-in",
      "recipe": "Cards and checks scale 0.6 to 1 on the pop spring (10 / 190 / 0.6), sampled on twos."
    },
    {
      "name": "spot-marker-fill",
      "recipe": "A clipped zigzag scribble in primary, offset 7, 5 px from the line, drawn on after the outline."
    }
  ],
  "widgets": [
    "SketchWords",
    "GreasePencilSheet",
    "LiveMarkup",
    "RunningList",
    "HeadStack"
  ],
  "forbidden": [
    "a stick figure or a circle-head figure",
    "a real person or a known cartoon character",
    "more than 2 spot colours in one frame",
    "gradients or glossy shading on the drawing",
    "boil on text or on the board",
    "all strokes appearing at once",
    "clip-art or stock icons",
    "a hex colour in a component",
    "a real logo"
  ]
}
