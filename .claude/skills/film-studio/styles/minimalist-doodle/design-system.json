{
  "style": "minimalist-doodle",
  "version": 1,
  "subject_mode": "layered",
  "subject_note": "Mode B, story actor, or Mode A presenter. An expressive illustrated host built in layers (back hair, torso, neck, head, ear, front hair, face, arms), drawn on in ink and filled with spot marker colour. Never a stick figure, never a real person, never a known cartoon character.",
  "surface_roles": [
    "bg",
    "surface",
    "highlight"
  ],
  "text_roles": {
    "body": [
      "ink"
    ],
    "display": [
      "ink"
    ]
  },
  "doodle": {
    "note": "Everything is inline SVG on a 1080 x 1920 viewBox, so stroke widths and lengths are real pixels. Ink lines draw on, spot colour fills follow, the ink layer boils on twos.",
    "board": {
      "grain_freq": 0.8,
      "grain_octaves": 3,
      "grain_alpha": 0.16,
      "fibre_freq": [
        0.012,
        0.9
      ],
      "fibre_alpha": 0.08,
      "vignette": 0.07,
      "note": "A warm textured board: flat bg, seeded fractal grain in ink at low alpha, long horizontal fibres, a soft edge vignette. Static: the board never boils."
    },
    "ink": {
      "line": 7,
      "thin": 4.5,
      "marker": 10,
      "cap": "round",
      "join": "round",
      "note": "One ink colour for every line. Line 7 px for outlines, thin 4.5 px for face details, marker 10 px for markup."
    },
    "draw": {
      "px_per_frame": 45,
      "min_frames": 4,
      "max_frames": 16,
      "overlap_frames": 2,
      "easing": "draw",
      "note": "Progressive draw-on: pathLength 1, dasharray 1, dashoffset 1 - t. Duration is length / 45 px, clamped to 4 to 16 frames. Strokes draw in pen order, each starting 2 frames before the last ends."
    },
    "boil": {
      "hold": 2,
      "seeds": [
        3,
        11,
        23
      ],
      "freq": 0.018,
      "octaves": 2,
      "scale": 3.5,
      "note": "2-frame line boil: feTurbulence feeds feDisplacementMap on the ink layer only. The seed holds for 2 frames and cycles through 3 values, so lines shimmer like redrawn animation. Max shift 1.75 px. Text and the board never boil."
    },
    "fill": {
      "pitch": 30,
      "width": 42,
      "angle": -35,
      "offset": [
        7,
        5
      ],
      "streak": {
        "width": 5,
        "mix": 0.2
      },
      "frames": 12,
      "note": "Spot colour marker fill: a zigzag scribble clipped to the shape, drawn on after the outline closes, set 7 px right and 5 px down from the line like a misregistered print. Thin darker streaks give the marker grain."
    },
    "markup": {
      "ellipse_stroke": 9,
      "ellipse_turn": 1.15,
      "swipe_frames": 8,
      "note": "LiveMarkup: a marker ellipse that overshoots its start by 15 percent, a highlighter swipe behind one label, and a hand arrow with a short note."
    },
    "spot": {
      "max_per_frame": 2,
      "note": "Selective spot colour: primary on the host clothing and one markup, highlight behind one label. Everything else is ink on the board."
    }
  },
  "host": {
    "note": "One layered illustrated host. Head about 0.36 of the visible height, a strong hair silhouette, readable brows and eyes, a dynamic pose with a bent elbow. Never a stick figure.",
    "layers": [
      "back hair (bun)",
      "torso and sweater fill",
      "neck",
      "head fill and outline",
      "ear",
      "front hair fill and outline",
      "brows",
      "eyes with catch-lights",
      "nose",
      "mouth",
      "pointing arm (upper arm, forearm, hand)"
    ],
    "size": {
      "head_w": 212,
      "head_h": 240,
      "neck_to_top": 400,
      "shoulders": 300
    },
    "roles": {
      "line": "ink",
      "skin": "skin (surface on focused palettes)",
      "hair": "hair (ink on focused palettes)",
      "sweater": "primary",
      "catch_light": "surface"
    },
    "asymmetry": {
      "brow_raise_px": 9,
      "brow_tilt_deg": -8,
      "head_tilt_deg": 4
    },
    "states": {
      "idle": "breathing bob 4 px on twos over 48 frames, a blink every 60 to 90 frames (3 frames)",
      "react": "brows up 12 px, eyes 1.35 times taller, mouth an O, a 14 px hop on the pop spring, for 14 frames",
      "act": "the arm swings up to point at the diagram on the point spring, the head tilts toward it, the mouth opens to explain"
    },
    "arm": {
      "upper": 140,
      "fore": 125,
      "rest_deg": [
        78,
        8
      ],
      "point_deg": [
        -54,
        -22
      ]
    }
  },
