  "numerals": {
    "tabular": true,
    "css": "font-variant-numeric: tabular-nums",
    "rule": "Every number is tabular."
  },
  "type_scale": {
    "hero": 132,
    "display": 108,
    "h1": 84,
    "h2": 64,
    "body": 44,
    "label": 34
  },
  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "card": {
      "radius": 28,
      "border": {
        "width": 2,
        "role": "ink",
        "alpha": 0.18
      }
    },
    "plate": {
      "radius": 18,
      "fill": "surface",
      "note": "Every label sits on an opaque plate. Text is never put on a blurred or moving plane."
    },
    "plane": {
      "bleed": {
        "w": 1900,
        "h": 2200
      },
      "note": "Each plane is authored 1900 x 2200 and centred, so a push and a pan never show its edge."
    },
    "atmosphere": {
      "haze": "blend(haze, bg, 0.35) at the horizon",
      "tint_far": 0.28,
      "tint_mid": 0.55,
      "note": "Far planes lean toward the haze colour; near planes lean toward bg darkened."
    },
    "blur": {
      "z3": 7,
      "z2": 0,
      "z1": 2,
      "z0": 3,
      "rack_frames": 24,
      "note": "Rack focus swaps which plane is 0. Z1 goes 2 to 0, Z2 goes 0 to 4, Z3 goes 7 to 8 and Z0 goes 3 to 4 px."
    },
    "actor": {
      "states": [
        "idle",
        "react",
        "act"
      ],
      "layers": [
        "shadow",
        "back-arm",
        "legs",
        "coat",
        "scarf",
        "head",
        "front-arm",
        "lantern",
        "glow"
      ],
      "note": "Flat vector cut-out, built once, three states, the same seed in every scene."
    },
    "whip": {
      "frames": 10,
      "blur_px": 18,
      "note": "A directional blur along x that follows the pan speed, and a settle on a spring."
    },
    "vignette": {
      "alpha": 0.5,
      "note": "A radial darkening at the frame edge, drawn above every plane."
    }
  },
  "motion": {
    "fps": 30,
    "hold": 10,
    "enter_frames": 10,
    "stagger_frames": 6,
    "min_hold_frames": 6,
    "camera": "a continuous Z-push (the camera moves forward all film), a short directional whip pan to the story beat, and a rack focus that follows it",
    "easings": {
      "push": [
        0.25,
        0.1,
        0.25,
        1
      ],
      "whip": [
        0.7,
        0,
        0.2,
        1
      ],
      "rack": [
        0.65,
        0,
        0.35,
        1
      ],
      "settle": [
        0.22,
        1,
        0.36,
        1
      ],
      "fade": [
        0.65,
        0,
        0.35,
        1
      ]
    },
    "springs": {
      "settle": {
        "damping": 14,
        "stiffness": 120,
        "mass": 1
      },
      "pop": {
        "damping": 11,
        "stiffness": 190,
        "mass": 0.8
      }
    },
    "pacing": {
      "note": "Push all film, whip pan 10 frames, rack focus 24 frames starting 4 frames after the whip, hold the new focus at least 30 frames."
    }
  },
  "composition": {
    "margin": 8,
    "align": "left",
    "anchors": [
      "title-top",
      "actor-lower-third",
      "layer-ladder-right",
      "caption-bottom"
    ],
    "safe": {
      "x": [
        8,
        85
      ],
      "y": [
        8,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "continuous-z-push",
      "recipe": "The camera moves forward by 220 px over the film. Each plane moves by its own parallax, so over the film Z3 grows 32 percent, Z2 19, Z1 12 and Z0 9."
    },
    {
      "name": "rack-focus-swap",
      "recipe": "Over 24 frames the blur of the hero plane rises to 4 px and the blur of the story plane falls to 0. Text and plates never blur."
    },
    {
      "name": "directional-whip-pan",
      "recipe": "The camera x moves 260 px in 10 frames on the whip bezier and settles on a spring; every plane gets an x only blur that follows the speed."
    },
    {
      "name": "layer-explode",
      "recipe": "The four planes slide apart along Z with the push, so the viewer sees the stack, then close up."
    },
    {
      "name": "dolly-zoom",
      "recipe": "The push goes forward while the perspective widens, so the subject stays the same size and the world behind it stretches."
    },
    {
      "name": "actor-states",
      "recipe": "The actor has idle, react and act. It breathes in idle, turns the head and lifts the lantern in react, and steps forward in act."
    }
  ],
  "widgets": [
    "LayerExplode",
    "PictureDive",
    "RackFocus",
    "DollyZoom",
    "StoryboardDeck"
  ],
  "forbidden": [
    "text on a blurred or moving plane",
    "a plane edge visible during a push or a pan",
    "every plane blurred the same amount",
    "a flat scene with only one plane",
    "a hero that is not the sharpest plane at rest",
    "parallax multipliers that do not rise from Z0 to Z3",
    "a photograph or a video",
    "default CSS ease or linear",
    "a label under 4.5:1",
    "a foreground plane that covers the actor face"
  ]
}
