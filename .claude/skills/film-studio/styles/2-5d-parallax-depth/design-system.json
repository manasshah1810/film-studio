{
  "style": "2-5d-parallax-depth",
  "version": 1,
  "subject_mode": "layered",
  "subject_note": "Mode B, a layered Story Actor. One flat vector cut-out figure on Z2, a world on Z0 and Z1, a soft frame on Z3. No photographs, no video, no network images.",
  "surface_roles": [
    "bg",
    "surface"
  ],
  "text_roles": {
    "body": [
      "ink"
    ],
    "display": [
      "ink"
    ]
  },
  "depth_planes": [
    {
      "id": "Z3",
      "name": "foreground frame",
      "z": 500,
      "blur_px": 7,
      "parallax": 1.56,
      "content": "rope, railing, reeds, a doorway edge; dark, soft, at the frame edges only"
    },
    {
      "id": "Z2",
      "name": "hero subject / Story Actor",
      "z": 0,
      "blur_px": 0,
      "parallax": 1,
      "content": "the actor and what the actor touches; the only sharp plane at rest"
    },
    {
      "id": "Z1",
      "name": "midground architecture",
      "z": -700,
      "blur_px": 2,
      "parallax": 0.67,
      "content": "buildings, arches, a tower, lamp posts; a lit window or lamp carries the story beat"
    },
    {
      "id": "Z0",
      "name": "atmospheric backdrop",
      "z": -1400,
      "blur_px": 3,
      "parallax": 0.5,
      "content": "sky, moon, far hills, haze; the lightest plane, nearly still"
    }
  ],
  "camera": {
    "perspective": 1400,
    "push_px": 220,
    "push_frames": 180,
    "note": "perspective 1400 px; a layer at translateZ(z) is scaled by (P - z0) / P at rest so every plane keeps its authored size; parallax = P / (P - z)"
  },
