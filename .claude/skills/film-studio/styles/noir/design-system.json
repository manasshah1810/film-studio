  "type_scale": {
    "hero": 13,
    "h1": 9.5,
    "h2": 6.8,
    "body": 4.3,
    "label": 3.2,
    "numeral": 28
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 24,
    "hold": 1,
    "easings": {
      "creep": [0.4, 0, 0.6, 1],
      "reveal": [0.1, 0, 0, 1],
      "cutaway": [0, 0, 0, 1],
      "smoke": [0.3, 0, 0.3, 1]
    },
    "enter_frames": 18,
    "stagger_frames": 6,
    "min_hold_frames": 40,
    "camera": "Shot at 24 fps. A slow push-in (2-3% over a scene) and nothing else: no whip, no shake, no rotation. Type is typed on; figures fade up out of the dark. Scene changes are a hard cut to black for 2 frames."
  },
  "textures": {
    "shaft_angle": 18,
    "blind_gap": 3.4,
    "shaft_opacity": 0.16,
    "vignette": 0.78,
    "grain_freq": 0.85,
    "grain_opacity": 0.2,
    "rim": 0.45,
    "rim_opacity": 0.85
  },
  "figure": {
    "head": 15,
    "headShape": "oval",
    "body": "taper",
    "bodyW": 40,
    "limb": 6,
    "limbStyle": "line",
    "legLen": 54,
    "torso": 50,
    "armLen": 48,
    "face": "none",
    "hands": false,
    "feet": true,
    "skin": "shadow",
    "limbRole": "color"
  },
  "composition": {
    "margin": 8,
    "align": "left",
    "anchors": ["bl", "tl", "bl", "tr"],
    "tilt": [0, 0]
  },
  "signature_moves": [
    {
      "name": "One shaft of blind-cut light",
      "recipe": "Each scene has exactly one light source: a highlight shaft 48% of the short side wide at 16%, tilted up to 18 deg, cut into slats by a 3.4 u venetian-blind mask (56% dark, 44% light) and blurred 0.5 u. Its position changes per scene; its count never does."
    },
    {
      "name": "Silhouettes with a rim",
      "recipe": "Figures and props collapse to the shadow role with no outline and no face. A highlight copy offset 0.45 u toward the light at 85% sits behind each shape, so only the lit edge shows as a thin rim."
    },
    {
      "name": "One colour in a grey world",
      "recipe": "primary appears on exactly 1 element per scene: the accessory, the key bar, the emphasised word. Everything else is bg, shadow, ink and highlight. Two accented things on one screen breaks the style."
    },
    {
      "name": "Typed evidence",
      "recipe": "Headlines and labels type on character by character over 18 frames with a soft bg halo (0.5 em) behind them so they survive the light shaft. Attributions are prefixed with a dash, like a file note."
    },
    {
      "name": "Vignette and breathing grain",
      "recipe": "A 78% vignette starting 38% from centre closes every frame, under overlay film grain (freq 0.85, 20%) whose seed changes every 2 frames. The grain is the only thing on screen that never stops moving."
    }
  ],
  "forbidden": ["Light or mid-tone backgrounds", "More than one accent-coloured element per scene", "Faces, outlines or interior detail on figures", "Bounces, pops, overshoots, shakes and whip pans", "More than one light shaft, or light with no source", "Flat even lighting with no vignette", "Rounded friendly type or rounded corners", "Real film stills, actors or studio logos"]
}
