  "composition": {
    "margin": 7,
    "align": "left",
    "anchors": ["tl", "tl", "bl", "tr"],
    "tilt": [-2.5, 2.5]
  },
  "signature_moves": [
    {
      "name": "It lives on a ruled page",
      "recipe": "Background is a notebook page: feint rules every 5.2 u in the shadow role at 40%, one primary margin rule at 55%, three punched holes down the left edge, paper grain at 14%. The page never changes inside a film."
    },
    {
      "name": "Every line drawn twice",
      "recipe": "Outlines are two passes of the same path, each wobbled separately by 1.1 figure units, width 1.3. The two passes must visibly miss each other in places; a single clean stroke reads as vector, not pencil."
    },
    {
      "name": "Coloured-pencil fill that misses the edge",
      "recipe": "Fills are the flat role colour at 50% through a rough displacement filter, so colour stops short of the outline in some places and spills over in others."
    },
    {
      "name": "Boxed and hatched number",
      "recipe": "The key figure is wiped on like handwriting, then a rough box is drawn round it twice (0.22 u, 80%) and seven short hatch strokes are added on the lower right as a pencil shadow."
    },
    {
      "name": "Underline, tape, margin doodles",
      "recipe": "Emphasis is a hand-drawn underline, never a colour swap. Hero titles get one strip of highlight tape (11 x 3.4 u, 72%, rotated -3 to -9 deg) on the top-left corner. Up to four small doodles sit only in the strips outside the platform-safe area."
    }
  ],
  "forbidden": ["Perfect geometry: straight rules, true circles, uniform stroke width", "Opaque flat fills or any gradient", "Fades, slides, scale pops: marks are drawn on", "Clean sans-serif or serif type anywhere", "More than three colours beyond ink in one panel", "Doodles inside the safe area or behind text", "Drop shadows other than pencil hatching", "A blank background: the page furniture is always there"]
}
