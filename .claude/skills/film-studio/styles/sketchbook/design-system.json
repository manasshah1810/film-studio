  "type_scale": {
    "hero": 14,
    "h1": 10,
    "h2": 7.2,
    "body": 4.6,
    "label": 3.5,
    "numeral": 28
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 3,
    "easings": {
      "draw": [0.4, 0, 0.2, 1],
      "flick": [0.1, 0.9, 0.2, 1],
      "hand": [0.5, 0, 0.5, 1],
      "rest": [0.3, 0, 0.3, 1]
    },
    "enter_frames": 20,
    "stagger_frames": 8,
    "min_hold_frames": 36,
    "camera": "Top-down on the page, locked. Everything is drawn on in reading order at pen speed; nothing fades or slides. Animate on threes (hold 3) so the line breathes like flipped pages."
  },
  "textures": {
    "rule_gap": 5.2,
    "rule_opacity": 0.4,
    "margin_opacity": 0.55,
    "grain_freq": 0.8,
    "grain_opacity": 0.14,
    "doodles": 4,
    "pencil_width": 1.3,
    "wobble": 1.1,
    "fill_alpha": 0.5
  },
