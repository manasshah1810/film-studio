{
  "style": "low-poly-isometric",
  "version": 1,
  "subject_mode": "layered",
  "subject_note": "Mode B, faceted 3D Story Actors. A floating diorama built from flat-shaded primitives in @remotion/three. Actors are 4 to 6 faceted parts, no faces. No photographs, no video, no generated 3D models.",
  "surface_roles": [
    "bg",
    "surface"
  ],
  "text_roles": {
    "body": [
      "ink"
    ],
    "display": [
      "ink"
    ]
  },
  "iso": {
    "note": "True isometric: an OrthographicCamera on the (1, 1, 1) diagonal. Pitch 35.264 degrees (atan(1 / sqrt 2)), yaw 45 degrees. All text is DOM on top of the canvas, never 3D text.",
    "camera": {
      "type": "orthographic",
      "pitch_deg": 35.264,
      "yaw_deg": 45,
      "position": [
        20,
        20,
        20
      ],
      "zoom_px_per_unit": 100,
      "near": 0.1,
      "far": 100
    },
    "grid": {
      "tiles": 6,
      "tile_unit": 1,
      "slab": 0.3,
      "earth": 0.35,
      "rock_depth": 4,
      "note": "A 6 x 6 tile island. Each tile is 1 unit. Tall things sit on the back rows so they do not hide short ones."
    },
    "centre_px": {
      "x": 540,
      "y": 900,
      "note": "Where the world origin lands on the 1080 x 1920 frame."
    },
    "lights": {
      "key": {
        "direction": [
          0.25,
          1,
          0.55
        ],
        "intensity": 2.2,
        "tint": "#FFF4E0",
        "casts_shadow": true
      },
      "rim": {
        "direction": [
          -0.7,
          0.45,
          -0.6
        ],
        "intensity": 1.1,
        "tint": "#CFE0FF",
        "casts_shadow": false
      },
      "ambient": {
        "intensity": 0.9
      },
      "note": "Key from the upper left front: top faces brightest, left faces mid, right faces darkest. Rim from behind for a cool edge. Top : left : right is about 1 : 0.6 : 0.42."
    },
    "shadow": {
      "map": 2048,
      "bounds": 9,
      "bias": -0.0004,
      "normal_bias": 0.03,
      "blob_alpha": 0.22,
      "note": "One shadow-casting light. A soft blob under the island shows it floats. On a dark bg the earth and rock are lifted so the island side is 1.6:1 or more against the sky."
    },
    "material": {
      "type": "meshLambertMaterial",
      "flat_shading": true,
      "tone_mapping": "none",
      "note": "flatShading on every material. No tone mapping, so a lit top face shows the palette colour."
    },
    "facets": {
      "cone_segments": 6,
      "cylinder_segments": 6,
      "sphere": "icosahedron detail 0",
      "note": "Low segment counts make the facets. No smooth spheres."
    },
    "pin": {
      "stem": 0.9,
      "stem_radius": 0.03,
      "head_radius": 0.3,
      "collar_radius": 0.36,
      "head": "octahedron",
      "spin_deg_per_frame": 2.4,
      "note": "A 3D callout pin: a thin stem and a faceted head in primary. A surface-coloured collar under the head keeps it apart from red roofs. Its number badge sits above the head, joined by a short ink leader."
    }
  },
  "camera": {
    "note": "The camera never moves. The world group turns (turntable drift) and scales (pull-back zoom)."
  },
