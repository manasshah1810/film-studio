  "type_scale": {
    "hero": 128,
    "display": 104,
    "h1": 80,
    "h2": 60,
    "body": 44,
    "label": 34
  },
  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "card": {
      "radius": 18,
      "pad": 22,
      "border": {
        "width": 4,
        "role": "ink",
        "alpha": 1
      },
      "drop": {
        "y": 8,
        "role": "ink",
        "alpha": 0.18
      },
      "note": "A label plate: surface fill, 4 px ink border, a flat 8 px drop."
    },
    "leader": {
      "width": 4,
      "role": "ink",
      "dot": 9,
      "note": "A straight leader from the plate to the pin head, drawn on in 10 frames."
    },
    "title_bar": {
      "w": 150,
      "h": 12,
      "role": "primary"
    }
  },
  "motion": {
    "fps": 30,
    "hold": 10,
    "enter_frames": 14,
    "stagger_frames": 2,
    "min_hold_frames": 6,
    "camera": "fixed isometric; the world turns and scales",
    "easings": {
      "settle": [
        0.22,
        1,
        0.36,
        1
      ],
      "drift": [
        0.45,
        0,
        0.55,
        1
      ],
      "fade": [
        0.65,
        0,
        0.35,
        1
      ]
    },
    "springs": {
      "tile": {
        "damping": 11,
        "stiffness": 170,
        "mass": 0.7
      },
      "build": {
        "damping": 9,
        "stiffness": 150,
        "mass": 0.8
      },
      "pull_back": {
        "damping": 9,
        "stiffness": 60,
        "mass": 1
      },
      "pin": {
        "damping": 8,
        "stiffness": 160,
        "mass": 0.8
      },
      "plate": {
        "damping": 13,
        "stiffness": 180,
        "mass": 0.8
      }
    },
    "turntable": {
      "deg": 5,
      "note": "The world turns from -5 to +5 degrees of yaw over the scene on a sine. Never a full spin."
    },
    "pull_back": {
      "from": 1.55,
      "to": 1,
      "start": 62,
      "note": "An elastic pull-back: the world scale springs from 1.55 to 1 and overshoots once."
    },
    "bob": {
      "px": 7,
      "period_frames": 90,
      "note": "The island floats up and down 7 px."
    },
    "pacing": {
      "note": "Rock in by frame 10, tiles pop from the back corner 2 frames apart, buildings pop from frame 30, pull-back at 62, pins at 96, 116 and 136, hold the last frame at least 30 frames."
    }
  },
  "composition": {
    "margin": 9,
    "align": "left",
    "anchors": [
      "kicker",
      "title",
      "diorama",
      "pins",
      "plates"
    ],
    "safe": {
      "x": [
        9,
        85
      ],
      "y": [
        7,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "slow-turntable-drift",
      "recipe": "The world group yaw goes from -5 to +5 degrees on a sine over the scene. Labels stay put; leaders follow the pins."
    },
    {
      "name": "spring-tile-pop-up",
      "recipe": "Each tile rises from 1.2 units below and scales from 0 on a spring 11/170/0.7, 2 frames apart, from the back corner to the front."
    },
    {
      "name": "elastic-pull-back-zoom",
      "recipe": "The world scale springs from 1.55 to 1 on 9/60/1, so it overshoots once and settles."
    },
    {
      "name": "pin-drop",
      "recipe": "A callout pin falls 3 units onto its target on a spring 8/160/0.8, then its head spins slowly."
    },
    {
      "name": "building-pop",
      "recipe": "A building scales from 0 at its base on a spring 9/150/0.8, with a small overshoot."
    },
    {
      "name": "island-bob",
      "recipe": "The island floats 7 px up and down over 90 frames; the blob shadow shrinks as it rises."
    }
  ],
  "widgets": [
    "LayerExplode",
    "DayDial",
    "Banknote",
    "PlayingGrid",
    "DollyZoom"
  ],
  "forbidden": [
    "a perspective camera",
    "smooth shading or a smooth sphere",
    "a loaded 3D model or a texture image",
    "3D text in the canvas",
    "text on the diorama with no plate",
    "tone mapping that greys the palette",
    "two shadow-casting lights",
    "a full 360 degree spin",
    "a tall building on the front rows",
    "a hex colour in a component",
    "default CSS ease or linear for a pop",
    "more than 3 pins on screen"
  ]
}
