  "numerals": {
    "tabular": true,
    "css": "font-variant-numeric: tabular-nums",
    "rule": "Every number is set tabular. A counting number sits in fixed width digit columns so it never shifts sideways."
  },
  "type_scale": {
    "hero": 132,
    "display": 108,
    "h1": 84,
    "h2": 64,
    "body": 44,
    "label": 34,
    "numeral": 200
  },
  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "card": {
      "radius": 28,
      "border": {
        "width": 2,
        "role": "ink",
        "alpha": 0.16
      },
      "padding": 48
    },
    "plate": {
      "radius": 18,
      "fill": "surface",
      "border": {
        "width": 3,
        "role": "node"
      },
      "note": "Every callout label sits on an opaque plate. Text never sits on stripes or on a glow."
    },
    "ground": {
      "stripe": {
        "angle": -18,
        "pitch": 36,
        "width": 2,
        "role": "ink",
        "alpha": 0.04
      },
      "grid": {
        "role": "ink",
        "alpha": 0.12,
        "width": 2
      }
    },
    "line": {
      "width": 9,
      "cap": "round",
      "join": "round",
      "role": "primary"
    },
    "node": {
      "radius": 15,
      "ring_radius": 34,
      "ring_width": 4,
      "role": "alert"
    },
    "glow": {
      "chain": [
        "feGaussianBlur stdDeviation 5 (inner)",
        "feGaussianBlur stdDeviation 14 (outer)",
        "feComponentTransfer slope 0.7 on the outer",
        "feMerge outer, inner, SourceGraphic"
      ],
      "inner": 5,
      "outer": 14,
      "outer_alpha": 0.7,
      "max_radius": 28,
      "region": "userSpaceOnUse, the plot rectangle only, so the glow can never bleed into a label or off the card",
      "never_on": [
        "text",
        "label plates",
        "grid lines",
        "axis labels"
      ]
    },
    "area": {
      "from_alpha": 0.38,
      "to_alpha": 0,
      "role": "primary",
      "note": "One vertical gradient under the line, revealed by the same clip that draws the line."
    }
  },
  "motion": {
    "fps": 30,
    "hold": 12,
    "enter_frames": 10,
    "stagger_frames": 6,
    "min_hold_frames": 6,
    "camera": "continuous drift: scale 1.00 to 1.03 and a 14 px pan across the whole film, never a cut, never stops",
    "easings": {
      "draw": [
        0.45,
        0,
        0.2,
        1
      ],
      "roll": [
        0.22,
        1,
        0.36,
        1
      ],
      "pop": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "drift": [
        0.37,
        0,
        0.63,
        1
      ],
      "focus": [
        0.65,
        0,
        0.35,
        1
      ]
    },
    "springs": {
      "pop": {
        "damping": 11,
        "stiffness": 190,
        "mass": 0.8
      },
      "pulse": {
        "damping": 14,
        "stiffness": 120,
        "mass": 1
      }
    }
  },
  "composition": {
    "margin": 8,
    "align": "left",
    "anchors": [
      "title-top",
      "numeral-left",
      "chart-card-centre",
      "stat-cards-lower"
    ],
    "safe": {
      "x": [
        8,
        85
      ],
      "y": [
        8,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "path-draw-on",
      "recipe": "The data line draws with pathLength 1 and strokeDashoffset 1 to 0 over 70 frames on the draw bezier. The area clip and the odometer follow the same progress value."
    },
    {
      "name": "odometer-roll",
      "recipe": "Each digit is a column of 0 to 9 that rolls on the roll bezier. Fixed width columns, tabular numerals, a leading zero fades instead of shifting the layout."
    },
    {
      "name": "continuous-drift",
      "recipe": "The whole scene scales 1.00 to 1.03 and pans 14 px over the film on the drift bezier. It never stops, so the frame is never dead."
    },
    {
      "name": "glow-node",
      "recipe": "A callout node pops with the pop spring, a ring pulses once, a leader line draws to an opaque label plate. The glow is the feGaussianBlur chain, clipped to the plot."
    },
    {
      "name": "area-gradient-reveal",
      "recipe": "A primary gradient fades from 38 percent to 0 under the line and is clipped to the line head so it grows with the curve."
    },
    {
      "name": "rack-focus",
      "recipe": "Everything but the active callout dims to 55 percent and the active plate lifts to full, then the focus moves to the next node."
    }
  ],
  "widgets": [
    "CloneRow",
    "OrbitRing",
    "Banknote",
    "GridCollapse",
    "RackFocus"
  ],
  "forbidden": [
    "any human figure, stick figure, silhouette or avatar",
    "text on a stripe or on a glow",
    "a label under 4.5:1",
    "a neon colour under 4.5:1 on its card",
    "proportional digits in a counter",
    "glow on text",
    "glow larger than 28 px",
    "more than 2 neon colours in one chart",
    "dark red or muted purple labels",
    "pure black ground",
    "default CSS ease or linear",
    "invented data presented as real"
  ]
}
