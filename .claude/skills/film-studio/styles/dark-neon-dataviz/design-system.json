{
  "style": "dark-neon-dataviz",
  "version": 1,
  "subject_mode": "ui-first",
  "subject_note": "Mode C, data first. The chart is the subject. Strictly zero people: no stick figures, no silhouettes, no avatars, no Narrator bust.",
  "surface_roles": [
    "bg",
    "surface"
  ],
  "text_roles": {
    "body": [
      "ink"
    ],
    "display": [
      "ink"
    ]
  },
  "luminance_tiers": [
    {
      "tier": 0,
      "name": "ground",
      "role": "bg",
      "hex": "#070B14",
      "use": "the whole frame"
    },
    {
      "tier": 1,
      "name": "card",
      "role": "surface",
      "hex": "#0F172A",
      "use": "chart cards, label plates, stat cards"
    },
    {
      "tier": 2,
      "name": "grid",
      "role": "ink",
      "alpha": 0.12,
      "use": "grid lines, axis lines, ground stripes; never text"
    },
    {
      "tier": 3,
      "name": "label",
      "role": "muted",
      "use": "axis labels and captions on a card; 4.5:1 or better on surface"
    },
    {
      "tier": 4,
      "name": "text",
      "role": "ink",
      "use": "titles, numerals, callout text"
    },
    {
      "tier": 5,
      "name": "neon",
      "role": "primary, highlight, alert",
      "use": "one data line, one callout colour; 4.5:1 or better on bg and surface"
    }
  ],
