  "type_scale": {
    "hero": 13,
    "h1": 9.5,
    "h2": 7,
    "body": 4.6,
    "label": 3.4,
    "numeral": 26
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 2,
    "easings": {
      "drop": [0.4, 0, 0.6, 1.3],
      "slide": [0.3, 0, 0.1, 1],
      "nudge": [0.5, 0, 0.5, 1],
      "rest": [0.2, 0, 0.2, 1]
    },
    "enter_frames": 10,
    "stagger_frames": 5,
    "min_hold_frames": 30,
    "camera": "Rostrum camera straight down on a table. Pieces are placed by hand: they drop in from above on twos (hold 2) and settle with a small overshoot. No zooms; a scene change is every piece lifting off, then the next set landing."
  },
  "textures": {
    "tear": 0.5,
    "shadow_blur": 0.9,
    "shadow_opacity": 0.28,
    "grain_freq": 1.1,
    "grain_opacity": 0.16,
    "cut_wobble": 1.4
  },
  "figure": {
    "head": 20,
    "headShape": "round",
    "body": "bean",
    "bodyW": 42,
    "limb": 7,
    "limbStyle": "line",
    "legLen": 40,
    "torso": 50,
    "armLen": 44,
    "face": "dots",
    "hands": true,
    "feet": true,
    "skin": "highlight",
    "limbRole": "color"
  },
  "composition": {
    "margin": 6,
    "align": "left",
    "anchors": ["tl", "tr", "tl", "bl"],
    "tilt": [-4, 4]
  },
  "signature_moves": [
    {
      "name": "No outlines, only edges",
      "recipe": "Shapes are flat paper with no stroke. Edges are wobbled 1.4 figure units so every side looks scissor-cut, under 16% paper grain; a ruler-straight edge is a defect."
    },
    {
      "name": "Every layer casts a shadow",
      "recipe": "Each piece drops a soft ink shadow: offset 0.35 u right and 0.6 u down, blur 0.9 u, 28%. Same light direction for every piece in the film. This shadow is the only depth cue."
    },
    {
      "name": "Boil on sixes",
      "recipe": "The cut edges are re-randomised every 6 frames while everything else holds still, so the picture breathes like stop motion. Never faster: on twos it reads as jitter."
    },
    {
      "name": "Headline on ink strips",
      "recipe": "Each headline line sits on its own strip of ink paper (padding 0.2 em, rotated up to 1.4 deg, corners clipped unevenly) with bg-coloured type and the emphasis word in highlight. Strips drop in one line at a time."
    },
    {
      "name": "Paper theatre set",
      "recipe": "Background is a highlight paper sun (16 u, slightly off round) over three torn hills stepping bg-shadow mix, shadow, shadow-ink mix, each casting the standard shadow on the one behind. The key figure sits on a lopsided highlight blob."
    }
  ],
  "forbidden": ["Outlines or strokes round any shape", "Gradients, glows, gloss, 3D bevels", "Perfect circles and ruler-straight edges", "Hard shadows or shadows in different directions", "Smooth continuous motion: pieces move on twos and boil on sixes", "Dark-background palettes (ink is always the dark sheet)", "More than five paper colours in a panel", "Photographic textures or real magazine clippings"]
}
