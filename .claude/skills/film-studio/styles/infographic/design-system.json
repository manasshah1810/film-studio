  "type_scale": {
    "hero": 13,
    "h1": 9,
    "h2": 6.4,
    "body": 4.2,
    "label": 3,
    "numeral": 28
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 1,
    "easings": {
      "ease_out": [0.16, 1, 0.3, 1],
      "in_out": [0.65, 0, 0.35, 1],
      "count": [0.2, 0.8, 0.2, 1]
    },
    "enter_frames": 18,
    "stagger_frames": 6,
    "min_hold_frames": 36,
    "camera": "No camera. The grid is fixed for the whole film; elements rise 60% of their line height into place with ease_out. Numbers count up with easing count and stop dead."
  },
  "textures": {
    "grid_cell": 4,
    "grid_dot": 0.16,
    "grid_opacity": 0.7,
    "band_w": 2.2,
    "card_mix": 0.45,
    "card_radius": 1.2
  },
  "figure": {
    "head": 13,
    "headShape": "round",
    "body": "taper",
    "bodyW": 34,
    "limb": 5,
    "limbStyle": "line",
    "legLen": 60,
    "torso": 50,
    "armLen": 46,
    "face": "none",
    "hands": false,
    "feet": false,
    "skin": "ink",
    "limbRole": "ink"
  },
  "composition": {
    "margin": 6,
    "align": "left",
    "anchors": ["tl", "bl", "tl", "tr"],
    "tilt": [0, 0]
  },
  "signature_moves": [
    {
      "name": "The 4 u dot grid",
      "recipe": "A dot every 4 u, radius 0.16 u, in the shadow role at 70% opacity, behind everything and never animated. Every zone edge sits on it."
    },
    {
      "name": "Count, then underline",
      "recipe": "A statistic counts from 0 to its value over the enter time with easing count (tabular figures, same decimals as the final value); then a 0.9 u rule in the accent colour draws under it left to right, with a second rule in shadow 1.5 u below."
    },
    {
      "name": "Edge band",
      "recipe": "One 2.2 u band in the panel accent colour runs the full height of one edge (side chosen by seed). It is the only decoration."
    },
    {
      "name": "Card with a corner tick",
      "recipe": "Charts and pictograms sit on a card: bg mixed 45% toward shadow, radius 1.2 u, growing up from its baseline; a 3 u ink corner tick marks its top-left."
    },
    {
      "name": "Pictogram people",
      "recipe": "People are signs: round ink head, tapered body in the cast colour, no face, no hands, no outline, limbs 1.9x width with round caps. They drop in from 12% above."
    }
  ],
  "forbidden": ["Outlines on shapes, drop shadows, gradients, 3D charts", "More than two data colours in one chart; the third series is ink", "A number without a label or a label without a unit", "Faces, expressions or speech bubbles as jokes", "Rotated or tilted elements: everything is square to the grid", "Decorative icons that carry no data", "Truncated or dual y-axes; bars always start at zero", "Centred body text"]
}
