  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 1,
    "easings": {
      "pop": [0.3, 1.5, 0.5, 1],
      "snap": [0.2, 0, 0, 1],
      "squash": [0.6, -0.3, 0.3, 1.4],
      "settle": [0.3, 0, 0.2, 1]
    },
    "enter_frames": 12,
    "stagger_frames": 5,
    "min_hold_frames": 30,
    "camera": "Front-on stage. Cuts only; one 6% punch-in per scene at most, 4 frames, on the gag. Everything enters with overshoot (easing pop) and lands with a 2-frame squash."
  },
