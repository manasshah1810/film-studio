    "margin": 5,
    "align": "left",
    "anchors": ["tl", "tr", "bl", "tl"],
    "tilt": [-3, 3]
  },
  "signature_moves": [
    {
      "name": "One fat outline",
      "recipe": "Every shape carries the same ink outline: width 2.6 figure units, round joins, never tapered, never coloured. Limbs are 1.5x their defined width so they read as rubber hose."
    },
    {
      "name": "Hard shadow, no blur",
      "recipe": "Props and big numerals drop a solid ink copy offset 0.9 u right and down. Blur radius 0. Display type gets the same shadow in the shadow role at 0.05-0.07 em."
    },
    {
      "name": "Sunburst sky",
      "recipe": "12 wedges (18 on a peak panel) from a point behind the cast, colour = bg mixed 35% toward highlight, rotating 0.06 deg per frame. Never more contrast than that: it is weather, not a pattern."
    },
    {
      "name": "Starburst number",
      "recipe": "The key figure sits on a 12-point star (inner radius 74%, each point jittered up to 12%), highlight fill, ink outline 0.5 u, hard ink shadow. Star scales from 0 and un-rotates 8 deg while the number pops."
    },
    {
      "name": "Everybody stands on the ground",
      "recipe": "A bowed ground band in the shadow role fills the bottom 14-20% with an ink top edge; each figure has an ink squash shadow (22% opacity ellipse, 60% of its width) that widens as it lands."
    }
  ],
  "forbidden": ["Gradients, glows, blurred or soft shadows", "Thin or coloured outlines; outline width changing inside a film", "Realistic proportions: heads are at least a third of body height", "Linear easing: every entrance overshoots", "Floating figures with no ground band or squash shadow", "More than two character colours plus skin in one panel", "Small type: nothing under 3.4 u", "Detailed backgrounds that compete with the cast"]
}
