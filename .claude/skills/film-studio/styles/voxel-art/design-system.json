{
  "style": "voxel-art",
  "version": 1,
  "subject_mode": "layered",
  "subject_note": "Mode B, story actor (Mode A presenter also allowed). Expressive voxel characters built from cubes on a half-voxel grid, standing in a cube diorama. Never a flat 2D figure, never a stick figure, never an existing game character or a real person.",
  "surface_roles": [
    "bg",
    "surface"
  ],
  "text_roles": {
    "body": [
      "ink"
    ],
    "display": [
      "ink"
    ]
  },
  "voxel": {
    "note": "Everything is a cube on one grid, drawn with InstancedMesh in @remotion/three through a true isometric orthographic camera. Faces are unlit: each face takes one of three exact shades from its world normal.",
    "camera": {
      "type": "orthographic",
      "position": [
        20,
        20,
        20
      ],
      "pitch_deg": 35.264,
      "yaw_deg": 45,
      "zoom_px_per_unit": 78,
      "near": 0.1,
      "far": 100,
      "centre_px": {
        "x": 540,
        "y": 960
      }
    },
    "grid": {
      "unit": 1,
      "hero_unit": 0.25,
      "note": "World blocks are 1 unit. Characters are built from 0.25 unit cubes (a quarter grid), and their feet land on whole-unit tops. Nothing sits off the grid at rest."
    },
    "shade": {
      "top": 1,
      "left": 0.8,
      "right": 0.62,
      "bottom": 0.5,
      "note": "Three-shade cube lighting: the light comes from the upper left, so top faces are the palette colour, left faces 0.8 of it and right faces 0.62. Picked from the world normal, so a turned cube keeps the right shade."
    },
    "ao": {
      "steps": [
        1,
        0.9,
        0.82,
        0.76
      ],
      "depth_steps": [
        1,
        0.88,
        0.78,
        0.7
      ],
      "note": "Stepped ambient shadows: a block darkens one step for each occupied cell beside it one layer up (at most 3). Underside layers darken one step per layer down. No smooth falloff."
    },
    "cast": {
      "march": [
        -1,
        1,
        1
      ],
      "max_steps": 6,
      "factor": 0.8,
      "note": "Grid-marched cast shadows: from each top block, step toward the light one cell at a time; any block on the way puts it in shadow at 0.8. Hard-edged, cell sized."
    },
    "grain": {
      "levels": [
        0.96,
        1,
        1.04
      ],
      "note": "Seeded per-block tint in 3 steps, so a flat run of same-colour blocks still shows the grid."
    },
    "island": {
      "size": 8,
      "underside_layers": 4,
      "corner_cut": true,
      "note": "An 8 x 8 floating island: grass top, earth below, each lower layer inset by one cell. Tall things on the back rows."
    },
    "drop": {
      "height": 6,
      "fall_frames": 8,
      "spread": [
        2,
        42
      ],
      "squash": 0.78,
      "note": "Gravity drop: a block falls 6 units in 8 frames with constant acceleration (y = h * (1 - t ^ 2)), then squashes for 2 frames. Order: lowest layer first, centre out, seeded jitter."
    },
    "hero_shadow": {
      "factor": 0.8,
      "sizes": [
        1,
        0.75,
        0.5
      ],
      "note": "The hero casts an opaque patch in the cast-shadow shade of the ground, shrinking in 3 steps as it rises."
    },
    "impact": {
      "frames": 2,
      "silhouette": {
        "sky": "highlight",
        "rays": "surface",
        "world": "ink",
        "hero": "surface"
      },
      "shake_px": [
        10,
        -8,
        5,
        0
      ],
      "rays": 14,
      "max_per_10s": 2
    },
    "flip": {
      "hop": 2.5,
      "frames": 16,
      "turn_deg": 360,
      "axis": "x"
    },
    "float": {
      "amp": 0.12,
      "period": 72,
      "note": "The island bobs on twos, in steps of 1/32 unit."
    }
  },
  "hero": {
    "note": "One expressive voxel character. Head about a third of the height, a clear silhouette, one asymmetry (a raised brow), one accessory (a cap with a brim and a scarf).",
    "build": {
      "legs": [
        2,
        3,
        2
      ],
      "torso": [
        5,
        3,
        3
      ],
      "arms": [
        1,
        3,
        2
      ],
      "head": [
        6,
        4,
        5
      ],
      "cap": [
        6,
        1,
        5
      ],
      "brim": [
        6,
        1,
        2
      ],
      "units": "hero cells (0.25 unit), width x height x depth"
    },
    "roles": {
      "suit": "highlight",
      "face": "surface",
      "eyes": "ink",
      "cap": "ink",
      "scarf": "primary",
      "boots": "ink"
    },
    "states": {
      "idle": "bob 1/8 unit every 10 frames, blink every 60 to 90 frames",
      "react": "land: squash then stepped spring back, eyes wide, mouth open",
      "act": "wave: one arm up, swinging 20 degrees on twos"
    }
  },
