  "numerals": {
    "variant": "tabular-nums",
    "note": "Live counters are fixed-length strings in tabular numerals."
  },
  "type_scale": {
    "hero": 120,
    "display": 104,
    "h1": 76,
    "h2": 52,
    "body": 44,
    "label": 32
  },
  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "plate": {
      "radius": 14,
      "pad": 22,
      "border": {
        "width": 4,
        "role": "ink"
      },
      "drop": {
        "x": 0,
        "y": 8,
        "role": "ink"
      },
      "note": "A toy-like plate: surface fill, a 4 px ink border and a hard 8 px ink drop below it, like a block edge. No blur."
    },
    "leader": {
      "width": 4,
      "role": "ink",
      "dot": 9
    },
    "kicker": {
      "role": "ink"
    }
  },
  "motion": {
    "fps": 30,
    "hold": 10,
    "enter_frames": 12,
    "stagger_frames": 3,
    "min_hold_frames": 6,
    "camera": "fixed isometric; blocks drop, the hero moves, the island floats",
    "easings": {
      "settle": [
        0.22,
        1,
        0.36,
        1
      ],
      "snap": [
        0.5,
        0,
        0.1,
        1
      ],
      "flip": [
        0.65,
        0,
        0.35,
        1
      ]
    },
    "springs": {
      "bounce": {
        "damping": 9,
        "stiffness": 180,
        "mass": 0.7
      },
      "plate": {
        "damping": 11,
        "stiffness": 200,
        "mass": 0.6
      }
    },
    "stepped": {
      "on": 2,
      "quantum": 0.125,
      "note": "Stepped spring bounce: the spring is sampled on twos (the frame floored to an even number) and its output snapped to 1/8, so motion clicks like stop-motion toys."
    },
    "pacing": {
      "note": "Island drops in 2 to 52, title 6 to 26, hero drops at 52 and lands at 60 (impact), plate at 70, wave 84 to 118, hop and flip 124 to 140 (impact), blink at 152, hold to 180."
    }
  },
  "composition": {
    "margin": 9,
    "align": "left",
    "anchors": [
      "kicker",
      "title",
      "island",
      "hero plate",
      "counters"
    ],
    "safe": {
      "x": [
        9,
        85
      ],
      "y": [
        6,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "gravity-drop-assembly",
      "recipe": "Blocks fall 6 units in 8 frames, lowest layer first, centre out, and squash for 2 frames on landing."
    },
    {
      "name": "stepped-spring-bounce",
      "recipe": "Any spring is sampled on twos and snapped to 1/8: squash, plate pops, the hero landing."
    },
    {
      "name": "3d-axis-flip",
      "recipe": "The hero hops 2.5 units and turns 360 degrees about one axis in 16 frames on the flip easing, then lands on the grid."
    },
    {
      "name": "impact-frame",
      "recipe": "On a hard landing: 1 frame of silhouettes (the world in ink, the hero cut out in surface) on a highlight sky with surface rays, 1 frame of ink-outlined rays, 4 frames of shake."
    },
    {
      "name": "three-shade-cubes",
      "recipe": "Top 1, left 0.8, right 0.62 of the palette colour, picked from the world normal."
    }
  ],
  "widgets": [
    "GravityDrop",
    "PlayingGrid",
    "Banknote",
    "DayDial",
    "ImpactFrame"
  ],
  "forbidden": [
    "a flat 2D or stick figure",
    "a character or block pattern copied from an existing game",
    "smooth lit shading or real-time lights on the blocks",
    "blocks or characters off the grid at rest",
    "a soft transparent black shadow",
    "textures or images on the cubes",
    "more than 2 impact frames per 10 s",
    "a hex colour in a component",
    "a real person or a real logo"
  ]
}
