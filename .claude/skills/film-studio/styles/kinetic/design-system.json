  "type_scale": {
    "hero": 22,
    "h1": 15,
    "h2": 9,
    "body": 4.8,
    "label": 3.2,
    "numeral": 44
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 1,
    "easings": {
      "slam": [0.9, 0, 0.1, 1],
      "snap": [0.2, 0, 0, 1],
      "whip": [0.7, 0, 0.2, 1]
    },
    "enter_frames": 7,
    "stagger_frames": 3,
    "min_hold_frames": 18,
    "camera": "The frame is the page. Hard cuts on the beat; words slam from 150% to 100% in 7 frames, then hold dead still. The ghost glyph drifts 6 u per panel; nothing else moves while a word is being read."
  },
  "textures": {
    "ghost_size": 0.95,
    "ghost_stroke": 0.5,
    "ghost_opacity": 0.5,
    "drift": 6,
    "slab_min": 0.16,
    "slab_max": 0.3
  },
  "figure": {
    "head": 14,
    "headShape": "round",
    "body": "block",
    "bodyW": 36,
    "limb": 7,
    "limbStyle": "block",
    "legLen": 56,
    "torso": 50,
    "armLen": 46,
    "face": "none",
    "hands": false,
    "feet": false,
    "skin": "ink",
    "limbRole": "color"
  },
  "composition": {
    "margin": 4,
    "align": "left",
    "anchors": ["tl", "bl", "tl", "br"],
    "tilt": [0, 0]
  },
  "signature_moves": [
    {
      "name": "Ghost glyph",
      "recipe": "The first letter of the panel's key word, set at 95% of the long side, outline only (0.5 u, secondary role, 50% opacity), cropped by at least one edge, drifting 6 u across the panel."
    },
    {
      "name": "The slab",
      "recipe": "One full-width slab in the shadow role, 16-30% of the height, flush to the top or bottom (by seed). Text may cross its edge; the slab never has a border."
    },
    {
      "name": "Slam and stop",
      "recipe": "Each line scales 150% to 100% in 7 frames with easing slam, lines staggered 3 frames. No settle, no bounce. The hold after the slam is at least 18 frames."
    },
    {
      "name": "Boxed word",
      "recipe": "The emphasis word sits in a solid accent box (padding 0.13 em each side) that wipes in left to right after the line lands; the word flips to whichever of ink or bg reads best on the box."
    },
    {
      "name": "Signs, not people",
      "recipe": "A figure is a single-colour block silhouette: no face, no hair, no outline, square caps, limbs 2.4x width. It cuts in on one frame."
    }
  ],
  "forbidden": ["Illustration, texture, gradients, photographs", "More than three colours visible in a panel", "Fades, eases longer than 8 frames, drifting text", "Centred paragraphs; more than 9 words on screen", "Mixing two display faces in one film", "Text set in the secondary role", "Faces or outlined figures", "Motion while the viewer is meant to be reading"]
}
