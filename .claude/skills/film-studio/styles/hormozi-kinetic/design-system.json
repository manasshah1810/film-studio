  "type_scale": {"hero": 180, "display": 150, "h1": 120, "h2": 84, "body": 56, "label": 38, "numeral": 240},
  "motion": {
    "fps": 30,
    "hold": 12,
    "enter_frames": 8,
    "stagger_frames": 5,
    "min_hold_frames": 6,
    "camera": "punch-in 1.00 to 1.06 on every power word, settle back over 14 frames",
    "easings": {
      "punch": [0.16, 1, 0.3, 1],
      "overshoot": [0.34, 1.56, 0.64, 1],
      "whip": [0.7, 0, 0.2, 1],
      "settle": [0.22, 1, 0.36, 1]
    },
    "springs": {
      "pop": {"damping": 11, "stiffness": 190, "mass": 0.8},
      "slam": {"damping": 9, "stiffness": 240, "mass": 0.9},
      "settle": {"damping": 18, "stiffness": 120, "mass": 1},
      "pullback": {"damping": 12, "stiffness": 150, "mass": 1}
    }
  },
  "composition": {"margin": 6, "align": "left", "anchors": ["caption-center-top", "bust-bottom-left", "widget-right-of-bust"], "tilt": [-3, 3],
    "safe": {"x": [6, 85], "y": [8, 80]}},
  "signature_moves": [
    {"name": "word-pop", "recipe": "Each spoken word enters with a spring (pop), scale 0.6 to 1 with overshoot, 5 frames after the last."},
    {"name": "power-word-block", "recipe": "The active word gets a solid primary block behind it and the text knocks out to bg. Scale 1.08."},
    {"name": "punch-in", "recipe": "Whole stage scales 1.00 to 1.06 on the power word, then settles back with the settle spring."},
    {"name": "pull-back", "recipe": "On a new beat the stage starts at 1.15 and springs back to 1 (pullback)."},
    {"name": "whip-cut", "recipe": "Hard cut with an x whip of 12 to 20 px blur on the last 4 frames of the old beat."},
    {"name": "impact-flash", "recipe": "3 frame ink flash plus a 2 px per frame shake for 6 frames on the payoff word."},
    {"name": "bust-react", "recipe": "Narrator brows lift and the near arm raises on every power word; blink every 2.5 to 4.5 s."},
    {"name": "comment-drop", "recipe": "A comment card springs in from below with a 2 degree tilt, likes count up over 20 frames."}
  ],
  "forbidden": [
    "centred fade-in titles",
    "lowercase captions",
    "more than 4 words highlighted at once",
    "a caption in the bottom 20% or right 15%",
    "default CSS ease or linear",
    "a stick figure or a full-body character",
    "gradient fills on captions",
    "drop shadow blur on captions"
  ]
}
