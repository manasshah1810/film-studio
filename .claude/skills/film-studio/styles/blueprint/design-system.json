  "type_scale": {
    "hero": 12.5,
    "h1": 9,
    "h2": 6.5,
    "body": 4.2,
    "label": 3.1,
    "numeral": 27
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 1,
    "easings": {
      "plot": [0, 0, 1, 1],
      "rule": [0.6, 0, 0.2, 1],
      "snap": [0.2, 0, 0, 1],
      "settle": [0.3, 0, 0.2, 1]
    },
    "enter_frames": 20,
    "stagger_frames": 5,
    "min_hold_frames": 36,
    "camera": "Orthographic and locked: no perspective, no rotation, no zoom. Lines are plotted at constant speed like a pen plotter; text types on; numbers count up. Scene changes are a horizontal wipe along a grid line."
  },
  "textures": {
    "grid": 2.5,
    "major_every": 4,
    "major_opacity": 0.3,
    "grid_opacity": 0.12,
    "frame": 3,
    "grain_freq": 0.9,
    "grain_opacity": 0.08,
    "line_width": 1.6,
    "hatch_gap": 3.2,
    "hatch_width": 0.7
  },
  "figure": {
    "head": 16,
    "headShape": "round",
    "body": "block",
    "bodyW": 38,
    "limb": 3,
    "limbStyle": "line",
    "legLen": 52,
    "torso": 50,
    "armLen": 48,
    "face": "none",
    "hands": false,
    "feet": true,
    "skin": "bg",
    "limbRole": "ink"
  },
  "composition": {
    "margin": 8,
    "align": "left",
    "anchors": ["tl", "tl", "bl", "tl"],
    "tilt": [0, 0]
  },
  "signature_moves": [
    {
      "name": "Sheet, grid and title block",
      "recipe": "Every frame is a drawing sheet: a 2.5 u grid at 12% with every fourth line at 30%, a 0.22 u ink border inset 3 u, and a mono title block in the bottom-right corner reading \"SHEET nn | NTS\" where nn is the scene number."
    },
    {
      "name": "Line and hatch, never fill",
      "recipe": "Objects are a constant 1.6-unit butt-capped outline. Mass is shown only with 45-degree hatching (gap 3.2, width 0.7); no shape is ever filled solid. Lines are plotted on stroke by stroke over 20 frames."
    },
    {
      "name": "Dimension line under the subject",
      "recipe": "A secondary-colour dimension line spans 72% of the visual zone 1.2 u beneath it: extension ticks 2.8 u tall and open arrowheads at both ends, drawn left to right after the object is complete."
    },
    {
      "name": "Callout ticks on the key figure",
      "recipe": "The key number counts up from zero and is framed by four L-shaped corner ticks 3 u long, set 1.6 u off its bounding box, each growing from its corner. No box, no circle."
    },
    {
      "name": "Everything labelled in mono",
      "recipe": "Kickers open with a slash and are set in the mono face at 3.1 u; attributions are prefixed \"REF: \"; chart labels and bubbles are mono with square corners. Emphasis is an underline, not a colour block."
    }
  ],
  "forbidden": ["Solid filled shapes: mass is hatched", "Perspective, 3D rotation or camera zoom", "Rounded corners, round line caps and soft shadows", "Bounces and overshoots: plotters do not bounce", "Line widths that vary within one drawing", "Type or objects placed off the grid or across the border", "Gradients and glows", "Real company title blocks, part numbers or patent drawings"]
}
