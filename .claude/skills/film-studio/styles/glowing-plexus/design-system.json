{
  "style": "glowing-plexus",
  "version": 1,
  "subject_mode": "ui-first",
  "subject_note": "Mode C, UI and data first. The one subject is a network: seeded nodes, distance-weighted links and light packets that travel along them. No people, no actors, no photographs, no video, no icons standing in for people.",
  "surface_roles": [
    "bg",
    "surface"
  ],
  "text_roles": {
    "body": [
      "ink",
      "primary"
    ],
    "display": [
      "ink"
    ]
  },
  "plexus": {
    "note": "A network drawn as light on a 2D canvas with additive compositing (lighter), projected from 3D by hand. Every position is a pure function of a seed and the frame number, so a frame renders the same every time.",
    "seed": "glowing-plexus-20",
    "rng": {
      "generator": "mulberry32",
      "hash": "fnv1a",
      "note": "One generator, seeded once from the string, consumed in a fixed order at build time. Never call Math.random, never draw a random number inside a frame."
    },
    "camera": {
      "fov": 40,
      "z_start": 10,
      "look": [
        0,
        0,
        0
      ],
      "note": "A pinhole camera on +z looking at -z. Focal length in px is (1920 / 2) / tan(fov / 2)."
    },
    "field": {
      "x": [
        -2.5,
        2.5
      ],
      "y": [
        -3.2,
        2.4
      ],
      "z": [
        -1.5,
        1.5
      ],
      "note": "World units. The web sits between the title and the readouts."
    },
    "clusters": {
      "count": 3,
      "nodes_each": 36,
      "sigma": 0.55,
      "clamp_sigma": 2.2,
      "note": "Each labelled hub seeds a cluster: nodes placed around it on a clamped normal, so hubs read as dense knots."
    },
    "scatter": {
      "nodes": 60,
      "note": "Uniform nodes across the field: the loose web that ties the clusters together."
    },
    "min_spacing": 0.2,
    "dust": {
      "count": 90,
      "x": [
        -3.8,
        3.8
      ],
      "y": [
        -6.2,
        6.2
      ],
      "z": [
        -6,
        -3
      ],
      "px": [
        1,
        2.2
      ],
      "alpha": [
        0.15,
        0.4
      ],
      "note": "Far points with no links, for depth. They drift slower than the web."
    },
    "edges": {
      "link": 0.75,
      "falloff_pow": 1.6,
      "max_alpha": 0.5,
      "core_px": 1.4,
      "halo_px": 5,
      "halo_alpha": 0.18,
      "lit_boost": 2,
      "lit_floor": 0.14,
      "note": "Two nodes link when their 3D distance is under link times the larger reach. Opacity is max_alpha * (1 - d / limit) ^ 1.6, so a link fades to nothing exactly at the limit and never pops."
    },
    "hubs": {
      "reach": 1.6,
      "core_px": 11,
      "halo_mult": 6,
      "weight_pow": 0.8,
      "node_core_px": [
        2.2,
        7.7
      ],
      "node_halo_mult": 4.5,
      "note": "Hub weighting: a node grows with its degree, w = (deg / max deg) ^ 0.8. A labelled hub reaches 1.6 times further, so it has the most links, and is drawn biggest."
    },
    "drift": {
      "z_per_frame": 0.008,
      "bob_amp": 0.05,
      "bob_period": [
        90,
        150
      ],
      "note": "Continuous Z-drift: the camera moves forward at a constant speed for the whole film, so near nodes slide out faster than far ones. Each node also bobs on its own sine with a seeded phase."
    },
    "focus": {
      "coc_px_per_unit": 6,
      "min_alpha": 0.15,
      "move_frames": 14,
      "note": "RackFocus: points away from the focus depth grow by a circle of confusion and dim so total light stays the same. The focus moves to each hub as it fires."
    },
    "pulse": {
      "hop_frames": 8,
      "hop_pad": 2,
      "packet_px": 5,
      "tail": 0.35,
      "flash_frames": 6,
      "bridge_frames": 24,
      "note": "A packet crosses a link in hop_frames * d / link + hop_pad frames. A node lights when its first packet lands. Bridges are the cause and effect links from hub to hub."
    },
    "hub_zoom": {
      "to": 1.6,
      "spring": "elastic",
      "ring_mult": 3.2,
      "note": "Elastic hub zoom: when a hub fires it springs to 1.6 times its size with an overshoot."
    },
    "orbit": {
      "ticks": 12,
      "deg_per_frame": 2,
      "tilt": 0.42,
      "alpha": 0.85,
      "older_alpha": 0.3
    },
    "beats": {
      "fire": [
        30,
        70,
        110
      ],
      "bridges": [
        [
          0,
          1,
          46
        ],
        [
          1,
          2,
          86
        ]
      ],
      "tags": [
        34,
        74,
        114
      ]
    }
  },
