  "numerals": {
    "variant": "tabular-nums",
    "note": "Every live value is a fixed-length string in tabular numerals, so a plate never reflows."
  },
  "type_scale": {
    "hero": 120,
    "display": 100,
    "h1": 76,
    "h2": 52,
    "body": 44,
    "label": 34
  },
  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "tag": {
      "radius": 10,
      "pad": 20,
      "border": {
        "width": 2,
        "role": "primary",
        "alpha": 1
      },
      "scrim_px": 28,
      "scrim_alpha": 0.9,
      "note": "A hub label plate: opaque surface fill, a thin primary border and a soft bg scrim around it that knocks the glowing links back, so the label never sits on light."
    },
    "leader": {
      "width": 2,
      "role": "primary",
      "ring": 10,
      "draw_frames": 8,
      "note": "A straight line from the plate edge to the projected hub, drawn after the plate lands."
    },
    "title_scrim": {
      "to_y": 24,
      "alpha": 0.92,
      "note": "A bg fade over the top of the frame, so the title sits on dark, not on links."
    },
    "vignette": {
      "alpha": 0.55
    }
  },
  "motion": {
    "fps": 30,
    "hold": 10,
    "enter_frames": 12,
    "stagger_frames": 3,
    "min_hold_frames": 6,
    "camera": "continuous forward Z-drift at a constant speed; never stops, never cuts",
    "easings": {
      "settle": [
        0.22,
        1,
        0.36,
        1
      ],
      "focus": [
        0.65,
        0,
        0.35,
        1
      ],
      "draw": [
        0.65,
        0,
        0.35,
        1
      ]
    },
    "springs": {
      "hub_zoom": {
        "damping": 6,
        "stiffness": 170,
        "mass": 0.6
      },
      "tag": {
        "damping": 14,
        "stiffness": 180,
        "mass": 0.7
      }
    },
    "intro": {
      "node_in": [
        0,
        20
      ],
      "seeded_delay": 14
    },
    "pacing": {
      "note": "Web in by 20, title 6 to 26, readouts 14 to 30, hub 1 fires at 30, bridge to hub 2 at 46, hub 2 fires at 70, bridge to hub 3 at 86, hub 3 fires at 110, the last node lights about 160, hold the last frame at least 20 frames."
    }
  },
  "composition": {
    "margin": 9,
    "align": "left",
    "anchors": [
      "kicker",
      "title",
      "web",
      "hub plates",
      "readouts"
    ],
    "safe": {
      "x": [
        9,
        85
      ],
      "y": [
        6,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "pulse-propagation",
      "recipe": "From the firing hub, a shortest path tree over the links sets each node an arrival frame; a packet with a short tail crosses each tree link, and the node flashes highlight when it lands."
    },
    {
      "name": "continuous-z-drift",
      "recipe": "The camera moves forward 0.008 units a frame for the whole film; near nodes slide out faster, dust barely moves."
    },
    {
      "name": "elastic-hub-zoom",
      "recipe": "A firing hub springs to 1.6 times its size on a spring 6/170/0.6 with an overshoot, and an orbit ring opens around it."
    },
    {
      "name": "distance-edge-opacity",
      "recipe": "Link alpha is 0.5 * (1 - d / limit) ^ 1.6 from the live 3D distance, so links breathe as nodes bob and fade out without popping."
    },
    {
      "name": "hub-weighting",
      "recipe": "Node size and glow grow with degree; labelled hubs reach 1.6 times further and are the biggest lights."
    },
    {
      "name": "rack-focus",
      "recipe": "The focus depth moves to each firing hub over 14 frames; everything off that depth swells and dims."
    }
  ],
  "widgets": [
    "OrbitRing",
    "GridCollapse",
    "PlayingGrid",
    "PromptBar",
    "RackFocus"
  ],
  "forbidden": [
    "Math.random or any unseeded randomness",
    "a random number drawn inside a frame",
    "a light bg (additive light needs a dark sky)",
    "links that appear or vanish at full strength (popping)",
    "a label on the web without a plate and scrim",
    "more than 3 labelled hubs",
    "a camera that stops, cuts or reverses",
    "packets that teleport or travel off a link",
    "a hex colour in a component",
    "a person, a face or a person icon"
  ]
}
