  "type_scale": {
    "hero": 14,
    "h1": 10,
    "h2": 7,
    "body": 4.5,
    "label": 3.4,
    "numeral": 30
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 2,
    "easings": {
      "cut": [0, 0, 0, 1],
      "punch": [0.2, 1.6, 0.4, 1],
      "whip": [0.7, 0, 0.1, 1],
      "settle": [0.3, 0, 0.2, 1]
    },
    "enter_frames": 6,
    "stagger_frames": 4,
    "min_hold_frames": 30,
    "camera": "Locked page. Elements appear on hard cuts (2 frames or fewer) the way the eye jumps between panels. One whip pan between scenes at most; speed lines only on the single peak panel."
  },
  "textures": {
    "gutter": 3,
    "panel_skew": 1.2,
    "panel_tint": 0.22,
    "dot_cell": 1.7,
    "dot_opacity": 0.4,
    "speed_opacity": 0.22,
    "border": 0.7,
    "grain_freq": 0.9,
    "grain_opacity": 0.1,
    "ink_width": 3,
    "tone_opacity": 0.3
  },
  "figure": {
    "head": 19,
    "headShape": "oval",
    "body": "taper",
    "bodyW": 40,
    "limb": 6.5,
    "limbStyle": "line",
    "legLen": 50,
    "torso": 50,
    "armLen": 48,
    "face": "brows",
    "hands": true,
    "feet": true,
    "skin": "bg",
    "limbRole": "color"
  },
  "composition": {
    "margin": 6,
    "align": "left",
    "anchors": ["tl", "bl", "tr", "tl"],
    "tilt": [-2, 2]
  },
  "signature_moves": [
    {
      "name": "One inked panel per screen",
      "recipe": "Every scene sits inside one four-sided panel: 3 u gutter of bare paper all round, each corner pushed up to 1.2 u off square, 0.7 u ink border with mitred corners. Nothing but a speech bubble tail may cross the border."
    },
    {
      "name": "Caption-box headline",
      "recipe": "Headlines are set in the dark role on a highlight box: 0.5 u ink border, hard ink shadow 0.8 u right and down, the whole box rotated -1.2 deg. The box scales 90% to 100% in 4 frames; the text cuts in, it does not fade."
    },
    {
      "name": "Ben-Day tone, never a gradient",
      "recipe": "Shade with dots only: a 45-degree ink dot screen at 30% over the right half of bodies and solid props, and a secondary-colour screen (cell 1.7 u, 40%) fading out of one panel corner."
    },
    {
      "name": "Impact burst behind the number",
      "recipe": "The key figure is italic, outlined 0.04 em in ink with a hard 0.05 em ink shadow, ringed by 26 butt-capped ink strokes 3-10 u long that shoot outward as it pops."
    },
    {
      "name": "Speed lines on the peak only",
      "recipe": "On the one panel marked peak, radial ink speed lines at 22% converge behind the subject. Used on any other panel the effect is forbidden: it has to mean something."
    }
  ],
  "forbidden": ["Gradients, blurs, glows, soft shadows", "Fades and slow eases: elements cut in", "More than one panel border style in a film", "Speed lines or bursts on more than one panel per scene", "Thin outlines: ink width never drops under 3 figure units", "Lowercase body copy inside a speech bubble", "Real comic characters, logos or publisher trade dress", "Type crossing the panel border"]
}
