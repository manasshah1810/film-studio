  "type_scale": {
    "hero": 14,
    "h1": 10,
    "h2": 7,
    "body": 4.4,
    "label": 3.3,
    "numeral": 30
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 2,
    "easings": {
      "press": [0.2, 0, 0, 1],
      "slip": [0.5, 0, 0.1, 1],
      "stamp": [0.3, 1.3, 0.5, 1],
      "lift": [0.4, 0, 1, 1]
    },
    "enter_frames": 12,
    "stagger_frames": 5,
    "min_hold_frames": 30,
    "camera": "Flat and locked, held on twos. Layers slide in as separate plates: the secondary ghost arrives 2 frames before the main shape and stops a hair short. No zoom, no rotation after landing. Scene changes are a full-bleed colour-plate wipe."
  },
  "textures": {
    "shape_scale": 0.62,
    "overprint_opacity": 0.78,
    "dot_cell": 1.5,
    "dot_opacity": 0.3,
    "grain_freq": 1.1,
    "grain_opacity": 0.2,
    "misreg": 0.5,
    "ghost_opacity": 0.7
  },
  "figure": {
    "head": 20,
    "headShape": "round",
    "body": "block",
    "bodyW": 44,
    "limb": 7,
    "limbStyle": "line",
    "legLen": 46,
    "torso": 50,
    "armLen": 46,
    "face": "dots",
    "hands": false,
    "feet": true,
    "skin": "bg",
    "limbRole": "color"
  },
  "composition": {
    "margin": 7,
    "align": "left",
    "anchors": ["tl", "bl", "tl", "tr"],
    "tilt": [-3, 3]
  },
  "signature_moves": [
    {
      "name": "Two plates overprinted",
      "recipe": "Every background carries one highlight circle (62% of the short side) and one shadow rectangle (90% x 62% of that), both multiplied onto the paper at 78% so their overlap makes a third colour. They share one corner of the frame and move corner per scene."
    },
    {
      "name": "Out of register",
      "recipe": "Display type and numerals carry a hard secondary-colour copy offset 0.045 em right and 0.03 em down with no blur. Shapes carry the same ghost at 0.5 u, 70% opacity. The offset direction never changes within a film."
    },
    {
      "name": "No outlines, ever",
      "recipe": "Shapes are flat spot-colour fills with butt-capped lines at 1.9x weight. Edges come from colour meeting colour or colour meeting paper; an ink keyline around a fill is forbidden."
    },
    {
      "name": "Halftone fade from one corner",
      "recipe": "A 15-degree dot screen in the accent colour (cell 1.5 u, radius 34%, 30%) is multiplied in from one corner and fades out by 46% of the frame. It is the only tonal gradient allowed."
    },
    {
      "name": "Sun behind the number",
      "recipe": "The key figure rises in front of a multiplied highlight circle 1.24x the numeral height, scaled from 0 to full in 10 frames, offset up to 20% sideways so it is never centred on the digits."
    }
  ],
  "forbidden": ["Ink outlines around filled shapes", "More than four ink colours on paper in one frame", "Smooth gradients, blurs, glows and soft shadows", "Dark backgrounds: multiply needs light stock", "Perfect registration: the ghost offset is always visible on display type", "Photographic or 3D imagery", "Pure black used as a fill colour for large areas", "Motion on ones: everything is held on twos"]
}
