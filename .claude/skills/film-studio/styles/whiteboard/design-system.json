 "type_scale": {
  "hero": 15,
  "h1": 10.5,
  "h2": 7.4,
  "body": 4.6,
  "label": 3.6,
  "numeral": 30
 },
 "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
 "motion": {
  "fps": 30,
  "hold": 1,
  "easings": {
   "write": [
    0.33,
    0,
    0.2,
    1
   ],
   "flick": [
    0.2,
    0.9,
    0.3,
    1.25
   ],
   "settle": [
    0.4,
    0,
    0.1,
    1
   ],
   "wipe": [
    0.7,
    0,
    0.3,
    1
   ]
  },
  "enter_frames": 26,
  "stagger_frames": 11,
  "min_hold_frames": 24,
  "camera": "Locked off. The board never moves; at most one 3% push per film, on the turn. Things arrive by being written, never by sliding or fading."
 },
 "textures": {
  "marker_width": 2.4,
  "wobble": 0.7,
  "double_stroke": 1,
  "hatch_gap": 3.6,
  "hatch_width": 1.5,
  "hatch_angle": -38,
  "ghost_opacity": 0.06,
  "ghost_blur_px": 2.2,
  "glare_opacity": 0.07,
  "grain_freq": 0.9,
  "grain_opacity": 0.05,
  "highlighter_skew_deg": -1.6,
  "highlighter_bleed": 0.14
 },
 "figure": {
  "head": 17,
  "headShape": "round",
  "body": "bean",
  "bodyW": 30,
  "limb": 3.6,
  "limbStyle": "noodle",
  "legLen": 46,
  "armLen": 50,
  "face": "dots",
  "hands": true,
  "feet": true,
  "skin": "bg",
  "limbRole": "ink",
  "torso": 50
 },
 "composition": {
  "margin": 6,
  "align": "left",
  "anchors": [
   "tl",
   "tl",
   "bl",
   "tr"
  ],
  "tilt": [
   -1.5,
   1.2
  ]
 },
 "signature_moves": [
  {
   "name": "Ghost of the last lesson",
   "recipe": "Behind every panel, 3-5 strokes and one word of the PREVIOUS panel remain at ghost_opacity 0.06 with a 2.2 px blur and a 40 px horizontal smear. The board has a history; it is never factory-clean."
  },
  {
   "name": "Hatch, never fill",
   "recipe": "Closed shapes are filled with parallel marker strokes: gap 3.6, width 1.5, angle -38 deg, clipped to the shape, drawn after the outline reaches 45%. Flat fills are forbidden."
  },
  {
   "name": "The circled number",
   "recipe": "The one key figure per film is circled by a two-loop ellipse (rx = text width x 0.62, second loop offset 2%, rotated -4 deg), stroke primary, width 1.4 x marker_width, drawn in 14 frames with easing flick, after the number is written."
  },
  {
   "name": "Highlighter swipe",
   "recipe": "The emphasis word gets a highlight-role bar BEHIND it: height 62% of the line, skew -1.6 deg, overshooting the word by 14% on the right, multiply blend on light boards, 55% opacity on dark boards. One swipe per panel at most."
  },
  {
   "name": "Because-arrow",
   "recipe": "Text and drawing are joined by one curved arrow (cubic, bow 18% of its length, wobble 0.7, open two-stroke head) in secondary, drawn in 12 frames with easing write, starting 6 frames after the headline lands. It points from cause to effect; it is never decoration."
  }
 ],
 "forbidden": [
  "A photographic or clip-art hand holding a marker",
  "Flat colour fills, gradients, drop shadows, glows",
  "Centred symmetric layouts: content starts at an edge like real board writing",
  "More than ink + 2 marker colours + 1 highlighter in a film",
  "Fades, slides, zooms on entrance: marks are written or wiped",
  "Perfect geometric lines without wobble",
  "Any typeface that is not hand-lettered (the mono role is for source lines only)",
  "Detailed faces: two dots and one line is the limit"
 ]
}
