  "type_scale": {
    "hero": 13,
    "h1": 9.5,
    "h2": 6.8,
    "body": 4.4,
    "label": 3.3,
    "numeral": 27
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 1,
    "easings": {
      "bleed": [0.2, 0, 0, 1],
      "bloom": [0.3, 0, 0.1, 1],
      "drift": [0.4, 0, 0.6, 1],
      "dry": [0, 0, 0.3, 1]
    },
    "enter_frames": 22,
    "stagger_frames": 8,
    "min_hold_frames": 45,
    "camera": "A very slow drift (under 2% scale over a scene), as if the paper is being looked over. Washes bloom outward before any line appears; nothing snaps, bounces or cuts inside a scene. Scene changes are a 12-frame wet dissolve."
  },
  "textures": {
    "bleed": 9,
    "wash_opacity": 0.34,
    "grain_freq": 0.75,
    "grain_opacity": 0.16,
    "pencil_width": 1.5,
    "wobble": 0.9,
    "fill_alpha": 0.72
  },
  "figure": {
    "head": 17,
    "headShape": "round",
    "body": "drop",
    "bodyW": 36,
    "limb": 3.4,
    "limbStyle": "noodle",
    "legLen": 48,
    "torso": 50,
    "armLen": 48,
    "face": "dots",
    "hands": false,
    "feet": true,
    "skin": "highlight",
    "limbRole": "ink"
  },
  "composition": {
    "margin": 9,
    "align": "center",
    "anchors": ["tl", "tr", "bl", "tl"],
    "tilt": [0, 0]
  },
  "signature_moves": [
    {
      "name": "Three washes on cold-press paper",
      "recipe": "Every background is bare paper plus exactly three pigment pools (accent, highlight, secondary) at 34% / 24% / 24%, each darker at its rim than its centre, edges roughened by 2.2 u of displacement. Paper grain (freq 0.75, 16%) goes over everything."
    },
    {
      "name": "Pigment first, pencil second",
      "recipe": "Shapes are filled at 72% opacity through a wet-edge filter (bleed 9) so colour pools past the line, then one 1.5-unit graphite outline with 0.9 wobble is laid on top. The fill fades in over 22 frames before the line is fully there."
    },
    {
      "name": "Brushstroke under the hero line",
      "recipe": "The hero headline sits on a single blurred highlight stroke: half a line tall, 3 u wider than the text each side, an uneven blob radius, 42% opacity, painted left to right in 16 frames."
    },
    {
      "name": "Number in a drying puddle",
      "recipe": "The key figure sits inside one highlight wash 1.44x its width, rotated up to 12 deg, rim darker than centre, growing from 70% to 100% as the numeral fades in. No box, no ring, no underline."
    },
    {
      "name": "Ground pool under the cast",
      "recipe": "Figures and objects never float: a flat shadow-colour wash 6 u tall sits under the visual zone at 75%, blurred 0.6 u, arriving before the subject."
    }
  ],
  "forbidden": ["Dark or saturated backgrounds: the ground is always light paper", "Hard-edged flat fills with no bleed", "Pure black outlines thicker than 2 figure units", "Snaps, bounces, overshoots and hard cuts within a scene", "More than three washes on one screen", "Body text on top of a wash rim", "Drop shadows, glows and gradients that read as digital", "Neon or fluorescent colours"]
}
