  "composition": {
    "margin": 5,
    "align": "left",
    "anchors": ["tl", "tl", "bl", "tr"],
    "tilt": [0, 0]
  },
  "signature_moves": [
    {
      "name": "One pixel size for everything",
      "recipe": "A screen pixel is 0.55 u. Sprites, floor tiles, stars, dither bands and box borders all snap to that grid; nothing is anti-aliased, rotated or scaled to a fraction."
    },
    {
      "name": "Sprites built row by row",
      "recipe": "Every figure and prop is rasterised to a 34-column grid with a one-cell ink outline, at most four colours, and loads from the bottom row upward over 16 frames like a slow cartridge."
    },
    {
      "name": "Dithered sky, tiled floor",
      "recipe": "Depth comes from three checkerboard dither bands above the horizon (50%, 25%, 17%) and a floor in the shadow role with an ink top row and 16 x 8 pixel tile lines at 35%. No gradients."
    },
    {
      "name": "Typed text, counted numbers",
      "recipe": "Headlines type on one character per step with a 0.09 em hard shadow in the shadow role. The key figure counts up from zero inside a dialog window: bg fill, ink border one block thick, hard ink shadow one block down-right."
    },
    {
      "name": "CRT glass on top",
      "recipe": "Finish with scanlines every two pixels at 10% and an ink vignette at 30% from 62% radius out. A few highlight stars blink on a 12-frame cycle. That is the only motion the background has."
    }
  ],
  "forbidden": ["Anti-aliasing, blur, glow, gradients, opacity fades on sprites", "Rotation or non-integer scaling of anything", "Smooth easing: motion is stepped on fours", "More than four colours in one sprite", "Curved vector shapes or thin lines beside the sprites", "Smooth (non-pixel) display type", "Mixed pixel sizes in one film", "Real game characters, sprites, logos or UI from existing games"]
}
