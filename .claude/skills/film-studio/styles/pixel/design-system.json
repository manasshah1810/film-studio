  "type_scale": {
    "hero": 13,
    "h1": 9.5,
    "h2": 6.8,
    "body": 4.6,
    "label": 3.6,
    "numeral": 28
  },
  "type_scale_note": "Sizes are in u (1 u = 1% of the short side). Max size; text is fitted down to its zone. A pairing may carry `scale` to correct a condensed or wide display face.",
  "motion": {
    "fps": 30,
    "hold": 4,
    "easings": {
      "step": [0, 0, 1, 1],
      "blip": [0, 1, 0, 1],
      "scroll": [0.2, 0, 0.8, 1],
      "drop": [0.5, 0, 1, 0.5]
    },
    "enter_frames": 16,
    "stagger_frames": 6,
    "min_hold_frames": 36,
    "camera": "Fixed screen. Movement happens in whole pixels on a 4-frame hold (7.5 fps): no sub-pixel drift, no rotation, no scaling. Scene changes are a hard cut or a 6-step wipe."
  },
  "textures": {
    "px": 0.55,
    "dither_opacity": 0.5,
    "stars": 14,
    "tile_opacity": 0.35,
    "scanline_opacity": 0.1,
    "vignette": 0.3,
    "sprite_cols": 34
  },
