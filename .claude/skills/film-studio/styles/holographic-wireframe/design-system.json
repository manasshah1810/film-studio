  "numerals": {
    "variant": "tabular-nums",
    "note": "Every live value is a fixed-length string in tabular numerals, so a tag never reflows."
  },
  "type_scale": {
    "hero": 120,
    "display": 100,
    "h1": 76,
    "h2": 52,
    "body": 44,
    "label": 34
  },
  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "tag": {
      "radius": 6,
      "pad": 20,
      "border": {
        "width": 3,
        "role": "primary",
        "alpha": 1
      },
      "note": "A callout tag: opaque surface fill, a thin primary border, number and name in primary mono, the value in ink."
    },
    "leader": {
      "width": 3,
      "role": "primary",
      "elbow": 40,
      "ring": 12,
      "draw_frames": 10,
      "note": "The tag scales in first, then the leader draws from its edge: 40 px straight, then a diagonal to the projected anchor, ending in a ring."
    },
    "bracket": {
      "inset": 36,
      "arm": 96,
      "stroke": 4,
      "role": "primary"
    },
    "scanlines": {
      "gap": 4,
      "line": 2,
      "alpha": 0.18
    }
  },
  "motion": {
    "fps": 30,
    "hold": 10,
    "enter_frames": 12,
    "stagger_frames": 3,
    "min_hold_frames": 6,
    "camera": "fixed perspective; the object turns and tilts",
    "easings": {
      "settle": [
        0.22,
        1,
        0.36,
        1
      ],
      "sweep": [
        0.45,
        0,
        0.55,
        1
      ],
      "draw": [
        0.65,
        0,
        0.35,
        1
      ]
    },
    "springs": {
      "explode": {
        "damping": 14,
        "stiffness": 70,
        "mass": 1
      },
      "tilt": {
        "damping": 12,
        "stiffness": 60,
        "mass": 1
      },
      "tag": {
        "damping": 14,
        "stiffness": 180,
        "mass": 0.7
      }
    },
    "rotation": {
      "yaw_start_deg": -40,
      "yaw_deg_per_frame": 0.45,
      "tilt_from_deg": 6,
      "tilt_to_deg": 16,
      "tilt_start": 62,
      "note": "3D axis rotation: a slow steady yaw, and one spring tilt on x when the layers explode."
    },
    "explode_start": 62,
    "gears": {
      "deg_per_frame": 3,
      "note": "Gears turn at speeds set by their tooth counts, so they look meshed."
    },
    "pacing": {
      "note": "Grid in by 20, first sweep reveals the object 12 to 46, explode and tilt at 62, sweeps at 70 and 128, tags at 96, 108 and 120, glitch at 58 and 150, hold the last frame at least 30 frames."
    }
  },
  "composition": {
    "margin": 9,
    "align": "left",
    "anchors": [
      "kicker",
      "title",
      "object",
      "tags",
      "readouts"
    ],
    "safe": {
      "x": [
        9,
        85
      ],
      "y": [
        6,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "axis-rotation",
      "recipe": "The object yaws 0.45 degrees a frame (-40 to +41 over 6 s, never edge-on at the end) and tilts on x from 6 to 16 degrees on a spring 12/60/1 as it explodes."
    },
    {
      "name": "scanline-sweep",
      "recipe": "A highlight band 0.07 units wide sweeps down the object in 36 frames on the sweep easing; edges in the band redraw thick, faces glow and fade behind it."
    },
    {
      "name": "rgb-chromatic-glitch",
      "recipe": "For 4 frames an SVG filter shifts the red channel left and the blue channel right by 10 px, sign flipping each frame."
    },
    {
      "name": "scan-reveal",
      "recipe": "The first sweep is a clipping plane: only what is above the band exists yet, so the object prints top down."
    },
    {
      "name": "layer-explode",
      "recipe": "Each layer slides along y by 0.5 units times its index on a spring 14/70/1."
    },
    {
      "name": "leader-draw",
      "recipe": "A tag scales in on 14/180/0.7, then its leader draws from the tag to the anchor in 10 frames."
    }
  ],
  "widgets": [
    "OrbitRing",
    "LensRing",
    "CodeBody",
    "RackFocus",
    "LayerExplode"
  ],
  "forbidden": [
    "a light bg (additive light needs a dark sky)",
    "solid lit shading or shadows",
    "plain 1 px lines for the main edges",
    "depth writes on faces or edges",
    "a loaded 3D model or a texture image",
    "3D text in the canvas",
    "text on the hologram with no tag",
    "a glitch longer than 4 frames or more than 2 per 10 s",
    "more than 3 tags on screen",
    "a hex colour in a component",
    "a person or an actor"
  ]
}
