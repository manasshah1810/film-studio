{
  "style": "holographic-wireframe",
  "version": 1,
  "subject_mode": "ui-first",
  "subject_note": "Mode C, UI and data first. The one subject is a hardware object drawn as a glowing wireframe hologram in @remotion/three. No people, no actors, no photographs, no video, no loaded 3D models.",
  "surface_roles": [
    "bg",
    "surface"
  ],
  "text_roles": {
    "body": [
      "ink",
      "primary"
    ],
    "display": [
      "ink"
    ]
  },
  "holo": {
    "note": "Two passes per part, both additive and both without depth writes: a translucent fresnel face pass, then a glowing edge pass from EdgesGeometry. The scene background is bg so additive light adds onto the real sky colour.",
    "camera": {
      "type": "perspective",
      "fov": 30,
      "position": [
        0,
        2.6,
        11
      ],
      "look_at": [
        0,
        0,
        0
      ],
      "near": 0.1,
      "far": 60
    },
    "faces": {
      "base": 0.05,
      "rim": 0.32,
      "fresnel_power": 2,
      "blending": "additive",
      "depth_write": false,
      "note": "Alpha rises toward the silhouette: base + rim * (1 - |n . v|) ^ 2. The middle of a face stays almost clear."
    },
    "edges": {
      "threshold_deg": 15,
      "core_px": 2.2,
      "halo_px": 9,
      "halo_opacity": 0.16,
      "scan_px": 3.6,
      "note": "Two line passes: a thin bright core and a wide faint halo. LineSegments2 with LineMaterial, because WebGL ignores linewidth on plain lines."
    },
    "scan": {
      "band": 0.07,
      "trail": 0.35,
      "period_frames": 36,
      "sweeps": [
        12,
        70,
        128
      ],
      "reveal_first": true,
      "frame": {
        "half": 1.6,
        "mark": 0.35,
        "opacity": 0.8
      },
      "band_boost": 0.3,
      "note": "A horizontal band in highlight sweeps down the object in world y. Edges inside the band are redrawn thick in highlight; faces brighten in the band and fade behind it. Four corner marks, not a full square, show the scan plane. The first sweep reveals the object."
    },
    "grid": {
      "y": -1.25,
      "extent": 8,
      "step": 0.5,
      "fade_radius": 7,
      "px": 1.4,
      "note": "A perspective floor grid in grid colour, fading to nothing by radius 7, drawn in by frame 20."
    },
    "object": {
      "scale_assembled": 0.88,
      "scale_exploded": 0.58,
      "centre_y": 0.45,
      "shift_x_exploded": 0.6,
      "note": "Assembled, the object is big and centred. Exploded, it shrinks and moves right so the tags have a clear column on the left."
    },
    "turntable": {
      "radius": 1.9,
      "ticks": 48,
      "note": "A ring with ticks on the floor under the object. It turns with the object yaw and follows its x shift."
    },
    "explode": {
      "gap": 0.5,
      "note": "LayerExplode: each layer moves gap * its index along y. The motor drops one gap, the horn rises four."
    },
    "glitch": {
      "frames": 4,
      "offset_px": 10,
      "max_per_10s": 2,
      "note": "RGB chromatic glitch: an SVG filter splits the red and blue channels sideways for 4 frames. Pure channel maths, no palette colour."
    }
  },
  "camera": {
    "note": "The camera never moves. The object turns on its y axis and tilts on x; leaders follow its anchors through the same projection."
  },
