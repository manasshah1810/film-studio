  "tokens": {
    "frame": {
      "w": 1080,
      "h": 1920,
      "note": "Tokens are pixels on the 1080 x 1920 frame."
    },
    "card": {
      "radius": 0,
      "border": {
        "width": 0,
        "role": "rule",
        "alpha": 0
      }
    },
    "rule": {
      "thick": 5,
      "thin": 2,
      "role": "ink",
      "note": "A 5 px rule over a 2 px rule under the masthead."
    },
    "shadow": {
      "role": "shadow",
      "blur": 24,
      "y": 18,
      "alpha": 0.55,
      "note": "One soft drop shadow under the whole clipping."
    },
    "tape": {
      "role": "tape",
      "w": 190,
      "h": 60,
      "alpha": 0.78,
      "rotate_deg": 35,
      "note": "Two pieces of masking tape on the top corners."
    },
    "halftone": {
      "pitch": 12,
      "small_r": 2.2,
      "big_r": 4.6,
      "note": "Pictures are halftone dots in ink, with one spot of red in primary."
    }
  },
  "motion": {
    "fps": 30,
    "hold": 10,
    "enter_frames": 18,
    "stagger_frames": 6,
    "min_hold_frames": 6,
    "camera": "locked; film gate weave 1 px at 12 fps",
    "easings": {
      "draw": [
        0.22,
        1,
        0.36,
        1
      ],
      "tear": [
        0.65,
        0,
        0.35,
        1
      ],
      "fade": [
        0.65,
        0,
        0.35,
        1
      ],
      "settle": [
        0.22,
        1,
        0.36,
        1
      ]
    },
    "springs": {
      "stamp": {
        "damping": 12,
        "stiffness": 220,
        "mass": 0.9
      },
      "tape": {
        "damping": 14,
        "stiffness": 180,
        "mass": 1
      }
    },
    "pacing": {
      "note": "Paper tears in over 18 frames, headline lines 6 frames apart, body types over 30 frames, marker sweep 24 frames, red pen notes 20 frames each, stamp at about frame 146, hold the last frame at least 30 frames."
    }
  },
  "composition": {
    "margin": 9,
    "align": "left",
    "anchors": [
      "masthead",
      "headline",
      "column",
      "figure",
      "margin-notes",
      "stamp"
    ],
    "safe": {
      "x": [
        8,
        85
      ],
      "y": [
        8,
        80
      ]
    }
  },
  "signature_moves": [
    {
      "name": "paper-tear-reveal",
      "recipe": "A jagged horizontal edge sweeps down the clipping over 18 frames, with a lighter fibre edge on the tear. Ease in out."
    },
    {
      "name": "marker-draw-on",
      "recipe": "A yellow highlighter grows over a line of type from left to right in 24 frames, ragged at the end, blended with multiply."
    },
    {
      "name": "stop-motion-jitter",
      "recipe": "Headline lines, notes and the stamp take a new random offset of 1.6 px and 0.5 degrees 12 times a second. Body text stays still."
    },
    {
      "name": "film-gate-flicker",
      "recipe": "A black overlay at up to 7 percent, a 1 px weave, dust specks and a scratch, re-rolled at 12 fps."
    },
    {
      "name": "red-pen-circle",
      "recipe": "A circle around a word, drawn with stroke-dashoffset, overshooting the start and spiralling out by 12 percent."
    },
    {
      "name": "serif-stamp",
      "recipe": "A boxed word in primary lands on a spring from 1.7x, rotated -9 degrees, with ink dropouts from feTurbulence."
    }
  ],
  "widgets": [
    "MagazineCover",
    "PressFront",
    "PaperTear",
    "LiveMarkup",
    "SerifStamp",
    "FilmLook",
    "ScreenplayPage"
  ],
  "forbidden": [
    "a photograph or a video",
    "text on the dark desk",
    "a flat colour block for the paper",
    "tape or stamp that hides text",
    "a perfectly straight torn edge",
    "marker without multiply",
    "jitter on the body text",
    "flicker above 8 percent",
    "a hex colour in a component",
    "a handwriting font under 48 px",
    "default CSS ease or linear for the tear",
    "more than one stamp per 10 s"
  ]
}
