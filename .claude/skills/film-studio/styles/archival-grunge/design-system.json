{
  "style": "archival-grunge",
  "version": 1,
  "subject_mode": "layered",
  "subject_note": "Layered paper. A dark desk, one torn paper clipping on it, then ink, marker and red pen drawn over the paper. The film look sits on top of everything. No person, no photo: the subject is the document.",
  "surface_roles": [
    "surface"
  ],
  "text_roles": {
    "body": [
      "ink",
      "primary"
    ],
    "display": [
      "ink",
      "primary"
    ]
  },
  "paper": {
    "note": "Surface is the paper, bg is the desk. All text sits on the paper. Red pen is role primary, the marker is role highlight and is drawn with multiply so the ink stays dark.",
    "clip": {
      "x": 54,
      "y": 77,
      "w": 972,
      "h": 1498,
      "rotate_deg": -1,
      "note": "The clipping in px on the 1080 x 1920 frame. Text boxes sit at least 40 px inside it."
    },
    "tear": {
      "amp_px": 14,
      "step_px": 18,
      "fibre_px": 6,
      "note": "Jagged edge: a point every 18 px, moved up to 14 px. A second, lighter polygon 6 px outside the paper shows the torn fibre."
    },
    "grain": {
      "freq": 0.9,
      "octaves": 2,
      "opacity": 0.26,
      "blotch_freq": 0.008,
      "blotch_opacity": 0.4,
      "note": "SVG feTurbulence. Fine grain in ink, big blotches in stain. Draw them under the text."
    },
    "marker": {
      "edge_jitter_px": 7,
      "height_pct": 82,
      "blend": "multiply",
      "note": "A highlighter sweep is a clip-path polygon that grows left to right with a ragged end, over the text, blended with multiply."
    },
    "pen": {
      "stroke": 5,
      "cap": "round",
      "note": "Red pen lines are paths drawn on with stroke-dashoffset and pathLength 1. Circles overshoot and spiral by 12 percent."
    },
    "jitter": {
      "fps": 12,
      "px": 1.6,
      "deg": 0.5,
      "note": "High frequency stop-motion jitter: headline lines, notes and the stamp move to a new random pose 12 times a second."
    },
    "flicker": {
      "fps": 12,
      "brightness": 0.07,
      "weave_px": 1,
      "specks": 14,
      "scratch_alpha": 0.18,
      "note": "Film gate flicker: a black overlay at up to 7 percent, a 1 px weave, dust specks and a scratch, all re-rolled 12 times a second."
    }
  },
  "camera": {
    "note": "A locked camera. The paper never slides around; only the film gate weave moves the whole frame by 1 px."
  },
