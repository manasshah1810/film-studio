{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "render-manifest",
 "description": "The ONE render input of FilmComposition (components/src/compositions/FilmComposition.tsx). Built by scripts/build-film.js from work/*.json. Everything is in frames; colours and fonts are role names resolved from styles/<design.style>/design-system.json at render time. No topic text lives in code.",
 "type": "object",
 "required": [
  "version",
  "meta",
  "design",
  "subject_mode",
  "cast",
  "panels",
  "captions",
  "audio",
  "showSafeZones"
 ],
 "additionalProperties": false,
 "properties": {
  "version": {
   "const": 1
  },
  "meta": {
   "type": "object",
   "required": [
    "title",
    "platform",
    "ratio",
    "fps",
    "width",
    "height",
    "frames",
    "safe"
   ],
   "additionalProperties": false,
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "platform": {
     "enum": [
      "studying",
      "instagram",
      "youtube",
      "youtube-shorts",
      "tiktok",
      "linkedin"
     ]
    },
    "ratio": {
     "enum": [
      "9:16",
      "16:9",
      "1:1",
      "4:5"
     ]
    },
    "fps": {
     "type": "integer",
     "minimum": 1,
     "maximum": 60
    },
    "width": {
     "type": "integer",
     "minimum": 1
    },
    "height": {
     "type": "integer",
     "minimum": 1
    },
    "frames": {
     "type": "integer",
     "minimum": 1
    },
    "safe": {
     "type": "object",
     "required": [
      "top",
      "right",
      "bottom",
      "left"
     ],
     "properties": {
      "top": {
       "type": "integer",
       "minimum": 0
      },
      "right": {
       "type": "integer",
       "minimum": 0
      },
      "bottom": {
       "type": "integer",
       "minimum": 0
      },
      "left": {
       "type": "integer",
       "minimum": 0
      }
     },
     "additionalProperties": false
    }
   }
  },
  "design": {
   "type": "object",
   "required": [
    "style",
    "palette_id",
    "palette_tier",
    "palette_size",
    "pairing_id",
    "seed"
   ],
   "additionalProperties": false,
   "properties": {
    "style": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "palette_id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pairing_id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "seed": {
     "type": "string",
     "minLength": 1
    },
    "palette_tier": {
     "enum": [
      "focused",
      "expanded"
     ]
    },
    "palette_size": {
     "type": "integer",
     "minimum": 3,
     "maximum": 12
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "palette_tier": {
        "const": "focused"
       }
      }
     },
     "then": {
      "properties": {
       "palette_size": {
        "minimum": 3,
        "maximum": 5
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "palette_tier": {
        "const": "expanded"
       }
      }
     },
     "then": {
      "properties": {
       "palette_size": {
        "minimum": 8,
        "maximum": 12
       }
      }
     }
    }
   ]
  },
  "subject_mode": {
   "enum": [
    "ui-first",
    "layered"
   ]
  },
  "cast": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "role",
     "layers"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     },
     "name": {
      "type": "string"
     },
     "role": {
      "enum": [
       "narrator",
       "actor",
       "prop"
      ]
     },
     "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "name",
        "shapes"
       ],
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "depth": {
         "type": "number"
        },
        "shapes": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "required": [
           "t"
          ],
          "properties": {
           "t": {
            "enum": [
             "rect",
             "ellipse",
             "poly",
             "line",
             "path"
            ]
           },
           "fill": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "A palette role name from the design system. Never a hex."
           },
           "stroke": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "A palette role name from the design system. Never a hex."
           }
          }
         }
        }
       }
      }
     },
     "rig": {
      "type": "object"
     }
    },
    "if": {
     "properties": {
      "role": {
       "enum": [
        "narrator",
        "actor"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "layers": {
       "minItems": 4
      }
     }
    }
   }
  },
  "panels": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "scene",
     "from",
     "frames",
     "max_hold_seconds",
     "boxes",
     "cast",
     "widgets",
     "motion",
     "beats"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^s[0-9]+p[0-9]+$"
     },
     "scene": {
      "type": "string",
      "pattern": "^s[0-9]+$"
     },
     "from": {
      "type": "integer",
      "minimum": 0
     },
     "frames": {
      "type": "integer",
      "minimum": 1
     },
     "max_hold_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 3.5,
      "description": "Longest gap between visual events in this panel (cut, beat, widget, motion, effect). 3.5 s at most."
     },
     "transition": {
      "type": "object",
      "required": [
       "primitive",
       "frames"
      ],
      "additionalProperties": false,
      "properties": {
       "primitive": {
        "enum": [
         "cut",
         "whip-pan",
         "axis-flip",
         "pull-back-zoom",
         "dolly-push"
        ]
       },
       "frames": {
        "type": "integer",
        "minimum": 0
       },
       "easing": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
       }
      }
     },
     "boxes": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "kind",
        "x",
        "y",
        "w",
        "h"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "kind": {
         "enum": [
          "text",
          "caption",
          "face",
          "card",
          "widget",
          "subject",
          "decor"
         ]
        },
        "role": {
         "enum": [
          "display",
          "body",
          "label",
          "caption"
         ]
        },
        "x": {
         "type": "number",
         "minimum": 0,
         "maximum": 100
        },
        "y": {
         "type": "number",
         "minimum": 0,
         "maximum": 100
        },
        "w": {
         "type": "number",
         "minimum": 0,
         "maximum": 100
        },
        "h": {
         "type": "number",
         "minimum": 0,
         "maximum": 100
        },
        "text": {
         "type": "string"
        },
        "lines": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "px": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "color": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9-]*$",
         "description": "A palette role name from the design system. Never a hex."
        },
        "bg": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9-]*$",
         "description": "A palette role name from the design system. Never a hex."
        },
        "font": {
         "enum": [
          "display",
          "body",
          "accent",
          "mono"
         ]
        },
        "from": {
         "type": "integer",
         "minimum": 0
        },
        "to": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     },
     "cast": {
      "type": "array",
      "maxItems": 2,
      "items": {
       "type": "object",
       "required": [
        "id",
        "box"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "box": {
         "type": "object",
         "required": [
          "x",
          "y",
          "w",
          "h"
         ],
         "properties": {
          "x": {
           "type": "number",
           "minimum": 0,
           "maximum": 100
          },
          "y": {
           "type": "number",
           "minimum": 0,
           "maximum": 100
          },
          "w": {
           "type": "number",
           "minimum": 0,
           "maximum": 100
          },
          "h": {
           "type": "number",
           "minimum": 0,
           "maximum": 100
          }
         },
         "additionalProperties": false
        },
        "flip": {
         "type": "boolean"
        },
        "from": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     },
     "widgets": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "anchor",
        "from",
        "frames",
        "box",
        "props"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9-]*$",
         "description": "An id from library/widgets.json."
        },
        "anchor": {
         "type": "string",
         "pattern": "^(tl|t|tr|l|r|bl|b|br|@[A-Za-z0-9_-]+)$"
        },
        "from": {
         "type": "integer",
         "minimum": 0
        },
        "frames": {
         "type": "integer",
         "minimum": 1
        },
        "props": {
         "type": "object"
        },
        "box": {
         "type": "object",
         "required": [
          "x",
          "y",
          "w",
          "h"
         ],
         "additionalProperties": false,
         "properties": {
          "x": {
           "type": "number",
           "minimum": 6,
           "maximum": 85
          },
          "y": {
           "type": "number",
           "minimum": 8,
           "maximum": 80
          },
          "w": {
           "type": "number",
           "minimum": 1,
           "maximum": 79
          },
          "h": {
           "type": "number",
           "minimum": 1,
           "maximum": 72
          }
         }
        }
       }
      }
     },
     "motion": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "primitive",
        "frame"
       ],
       "additionalProperties": false,
       "properties": {
        "primitive": {
         "enum": [
          "spring-overshoot",
          "gravity-drop",
          "pull-back-zoom",
          "whip-pan",
          "dolly-push",
          "text-decode",
          "odometer-roll",
          "path-draw-on",
          "axis-flip",
          "rgb-split-glitch",
          "stop-motion-jitter",
          "film-gate"
         ]
        },
        "frame": {
         "type": "integer",
         "minimum": 0
        },
        "frames": {
         "type": "integer",
         "minimum": 1
        },
        "target": {
         "type": "string",
         "description": "A box id in this panel, or \"panel\"."
        },
        "params": {
         "type": "object"
        },
        "note": {
         "type": "string"
        }
       }
      }
     },
     "beats": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "frame",
        "kind"
       ],
       "additionalProperties": false,
       "properties": {
        "frame": {
         "type": "integer",
         "minimum": 0
        },
        "frames": {
         "type": "integer",
         "minimum": 1
        },
        "kind": {
         "enum": [
          "enter",
          "exit",
          "move",
          "scale",
          "swap",
          "camera",
          "reveal",
          "count",
          "emphasis"
         ]
        },
        "target": {
         "type": "string"
        },
        "easing": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
       }
      }
     },
     "fx": {
      "type": "array",
      "description": "VFX Director effects from library/vfx (components/effects), wrapped around the panel innermost first.",
      "items": {
       "type": "object",
       "required": [
        "id",
        "from",
        "frames"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "from": {
         "type": "integer",
         "minimum": 0
        },
        "frames": {
         "type": "integer",
         "minimum": 1
        },
        "params": {
         "type": "object"
        }
       }
      }
     },
     "bespoke": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "anchor",
        "from",
        "frames",
        "box",
        "props"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$",
         "description": "A bespoke scene id <topic>/<scene> registered in components/bespoke/registry.ts."
        },
        "anchor": {
         "type": "string",
         "pattern": "^(tl|t|tr|l|r|bl|b|br|@[A-Za-z0-9_-]+)$"
        },
        "from": {
         "type": "integer",
         "minimum": 0
        },
        "frames": {
         "type": "integer",
         "minimum": 1
        },
        "props": {
         "type": "object"
        },
        "box": {
         "type": "object",
         "required": [
          "x",
          "y",
          "w",
          "h"
         ],
         "additionalProperties": false,
         "properties": {
          "x": {
           "type": "number",
           "minimum": 6,
           "maximum": 85
          },
          "y": {
           "type": "number",
           "minimum": 8,
           "maximum": 80
          },
          "w": {
           "type": "number",
           "minimum": 1,
           "maximum": 79
          },
          "h": {
           "type": "number",
           "minimum": 1,
           "maximum": 72
          }
         }
        }
       }
      },
      "description": "Bespoke topic scenes, mounted through components/bespoke/registry.ts."
     }
    }
   }
  },
  "captions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "from",
     "to",
     "text"
    ],
    "additionalProperties": false,
    "properties": {
     "from": {
      "type": "integer",
      "minimum": 0
     },
     "to": {
      "type": "integer",
      "minimum": 0
     },
     "text": {
      "type": "string",
      "pattern": "^\\s*\\S+(\\s+\\S+){0,4}\\s*$",
      "description": "5 words at most."
     },
     "power": {
      "type": "string",
      "pattern": "^\\S+$"
     }
    }
   }
  },
  "audio": {
   "type": "object",
   "required": [
    "sfx",
    "voiceover",
    "music"
   ],
   "additionalProperties": false,
   "properties": {
    "sfx": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "frame",
       "peak_frame",
       "pre_roll",
       "db",
       "sync"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
       },
       "frame": {
        "type": "integer",
        "minimum": 0
       },
       "peak_frame": {
        "type": "integer",
        "minimum": 0
       },
       "pre_roll": {
        "type": "integer",
        "minimum": 0,
        "maximum": 12
       },
       "db": {
        "type": "number",
        "minimum": -40,
        "maximum": 0
       },
       "sync": {
        "type": "string",
        "pattern": "^(cut|beat|widget|motion|transition):",
        "description": "The visual event this cue lands on, e.g. \"motion:s2p1#0\". validate-schema.js checks peak_frame is within 2 frames of that event and frame = peak_frame - pre_roll."
       },
       "file": {
        "type": [
         "string",
         "null"
        ],
        "description": "Path under work/ (the render public dir). null = no file yet; the cue is listed but silent."
       }
      }
     }
    },
    "voiceover": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "clips",
        "segments"
       ],
       "additionalProperties": false,
       "properties": {
        "clips": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "file",
           "from"
          ],
          "additionalProperties": false,
          "properties": {
           "file": {
            "type": "string"
           },
           "from": {
            "type": "integer",
            "minimum": 0
           }
          }
         }
        },
        "segments": {
         "type": "array",
         "items": {
          "type": "array",
          "prefixItems": [
           {
            "type": "integer",
            "minimum": 0
           },
           {
            "type": "integer",
            "minimum": 0
           }
          ],
          "minItems": 2,
          "maxItems": 2
         }
        }
       }
      }
     ]
    },
    "music": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "file",
        "open_db",
        "ducked_db",
        "attack_frames",
        "release_frames",
        "merge_gaps_under"
       ],
       "additionalProperties": false,
       "properties": {
        "file": {
         "type": "string"
        },
        "open_db": {
         "type": "number",
         "maximum": 0
        },
        "ducked_db": {
         "type": "number",
         "maximum": 0
        },
        "attack_frames": {
         "type": "integer",
         "minimum": 0
        },
        "release_frames": {
         "type": "integer",
         "minimum": 0
        },
        "merge_gaps_under": {
         "type": "integer",
         "minimum": 0
        },
        "cuts": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "from",
           "to"
          ],
          "properties": {
           "from": {
            "type": "integer",
            "minimum": 0
           },
           "to": {
            "type": "integer",
            "minimum": 0
           }
          }
         }
        }
       }
      }
     ]
    },
    "sfx_duck": {
     "type": "number",
     "minimum": 0,
     "maximum": 1,
     "description": "Gain applied to every SFX cue while the narrator speaks (voiceover segments). 0.25 = 25%."
    },
    "mix": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "file"
     ],
     "additionalProperties": false,
     "properties": {
      "file": {
       "type": "string"
      },
      "layers": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "description": "work/voiceover.mp3 from scripts/sound-bed.js: narration + pulse bed + sub-bass hits + transition SFX, pre-mixed. When set, FilmComposition plays only this track."
    }
   }
  },
  "showSafeZones": {
   "type": "boolean",
   "description": "true draws the 9:16 platform dead zones (bottom 20%, right 15%) over the film. Review renders only."
  }
 }
}
