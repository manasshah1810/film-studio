{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "assets"
 ],
 "properties": {
  "assets": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "def",
     "approved",
     "round"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     },
     "need_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     },
     "notes": {
      "type": "string"
     },
     "approved": {
      "type": "boolean"
     },
     "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
     },
     "def": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "kind",
         "color"
        ],
        "properties": {
         "kind": {
          "const": "character"
         },
         "name": {
          "type": "string"
         },
         "color": {
          "enum": [
           "primary",
           "secondary",
           "highlight",
           "shadow",
           "ink"
          ]
         },
         "hair": {
          "enum": [
           "none",
           "short",
           "bun",
           "spike",
           "cap",
           "long"
          ]
         },
         "build": {
          "enum": [
           "slim",
           "mid",
           "broad"
          ]
         },
         "accessory": {
          "enum": [
           "none",
           "tie",
           "glasses",
           "crown",
           "scarf"
          ]
         },
         "species": {
          "enum": [
           "human",
           "cat"
          ]
         },
         "layers": {
          "type": "array",
          "minItems": 4,
          "description": "A layered subject: at least 4 named layers (head or face, torso, limbs, shadow). Not only ellipse and line shapes.",
          "items": {
           "type": "object",
           "required": [
            "name",
            "shapes"
           ],
           "properties": {
            "name": {
             "type": "string"
            },
            "depth": {
             "type": "number"
            },
            "shapes": {
             "type": "array",
             "minItems": 1,
             "items": {
              "type": "object",
              "required": [
               "t"
              ]
             }
            }
           },
           "additionalProperties": false
          }
         },
         "mode": {
          "enum": [
           "presenter",
           "actor"
          ],
          "description": "presenter = the Narrator (one host to camera); actor = a story character. personas/casting-rig-designer.md section 1."
         },
         "seed": {
          "type": "string",
          "maxLength": 80
         },
         "variant_of": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
         },
         "rig": {
          "type": "object",
          "description": "Eyes, brows, mouth visemes, arm joints, shadow (casting-rig-designer.md section 2)."
         }
        },
        "additionalProperties": false
       },
       {
        "type": "object",
        "required": [
         "kind"
        ],
        "properties": {
         "kind": {
          "const": "prop"
         },
         "name": {
          "type": "string"
         },
         "base": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
         },
         "vb": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
         },
         "shapes": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "t"
           ],
           "properties": {
            "t": {
             "enum": [
              "rect",
              "ellipse",
              "poly",
              "line"
             ]
            },
            "fill": {
             "enum": [
              "bg",
              "ink",
              "primary",
              "secondary",
              "highlight",
              "shadow",
              "none"
             ]
            },
            "stroke": {
             "enum": [
              "bg",
              "ink",
              "primary",
              "secondary",
              "highlight",
              "shadow",
              "none"
             ]
            }
           }
          },
          "maxItems": 40
         }
        },
        "additionalProperties": false,
        "anyOf": [
         {
          "required": [
           "base"
          ]
         },
         {
          "required": [
           "shapes",
           "vb"
          ]
         }
        ]
       },
       {
        "type": "object",
        "required": [
         "kind",
         "file",
         "credit"
        ],
        "properties": {
         "kind": {
          "const": "media"
         },
         "file": {
          "type": "string"
         },
         "credit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
         }
        },
        "additionalProperties": false
       }
      ]
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false,
 "title": "cast",
 "description": "Characters and props as data. Colours are palette roles; nothing here is an image prompt."
}
