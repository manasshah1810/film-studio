{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "brief_hash",
  "stages"
 ],
 "properties": {
  "brief_hash": {
   "type": "string"
  },
  "updated": {
   "type": "string"
  },
  "stages": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "director",
     "treasurer",
     "scriptwriter",
     "casting",
     "art-director",
     "widget-integrator",
     "motion-choreographer",
     "vfx-director",
     "sound-designer",
     "checks",
     "pass1",
     "qa-inspector",
     "pass2"
    ]
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "status",
     "round",
     "output_path"
    ],
    "properties": {
     "status": {
      "enum": [
       "pending",
       "running",
       "passed",
       "flagged",
       "failed"
      ]
     },
     "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
     },
     "output_path": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false,
 "title": "state",
 "description": "Written only by scripts/state-manager.js. One entry per persona stage (references/director-cheatsheet.md), so an interrupted run resumes from the last completed stage."
}
