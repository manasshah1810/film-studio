{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "scenes"
 ],
 "properties": {
  "scenes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "panels"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^s[0-9]+$"
     },
     "panels": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "duration",
        "layout",
        "slots",
        "asset_ids"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^s[0-9]+p[0-9]+$"
        },
        "duration": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "layout": {
         "enum": [
          "title",
          "stat",
          "figure",
          "versus",
          "chart",
          "object",
          "quote",
          "timeline",
          "list"
         ]
        },
        "asset_ids": {
         "type": "array",
         "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
         }
        },
        "anchor": {
         "enum": [
          "tl",
          "t",
          "tr",
          "l",
          "c",
          "r",
          "bl",
          "b",
          "br"
         ]
        },
        "scale": {
         "enum": [
          "tight",
          "mid",
          "wide"
         ]
        },
        "energy": {
         "enum": [
          "calm",
          "build",
          "peak",
          "release"
         ]
        },
        "accent": {
         "enum": [
          "primary",
          "secondary",
          "highlight",
          "ink"
         ]
        },
        "caption": {
         "type": "string",
         "maxLength": 90
        },
        "recipe": {
         "type": "string",
         "description": "Name of the layout recipe from the style manual this panel follows."
        },
        "slots": {
         "type": "object",
         "required": [],
         "properties": {
          "kicker": {
           "type": "string",
           "minLength": 1,
           "maxLength": 40
          },
          "headline": {
           "type": "string",
           "minLength": 1,
           "maxLength": 70
          },
          "sub": {
           "type": "string",
           "minLength": 1,
           "maxLength": 110
          },
          "emphasis": {
           "type": "string",
           "minLength": 1,
           "maxLength": 30
          },
          "stat": {
           "type": "object",
           "required": [
            "value"
           ],
           "properties": {
            "value": {
             "type": "string",
             "minLength": 1,
             "maxLength": 10
            },
            "unit": {
             "type": "string",
             "minLength": 1,
             "maxLength": 8
            },
            "label": {
             "type": "string",
             "minLength": 1,
             "maxLength": 60
            }
           },
           "additionalProperties": false
          },
          "cast": {
           "type": "array",
           "items": {
            "type": "object",
            "required": [
             "id"
            ],
            "properties": {
             "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
             },
             "pose": {
              "enum": [
               "idle",
               "point",
               "walk",
               "cheer",
               "slump",
               "think",
               "shrug",
               "run",
               "hold",
               "fall",
               "reach"
              ]
             },
             "expr": {
              "enum": [
               "neutral",
               "happy",
               "worried",
               "shocked",
               "smug",
               "sad",
               "angry"
              ]
             },
             "flip": {
              "type": "boolean"
             },
             "says": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
             }
            },
            "additionalProperties": false
           },
           "minItems": 1,
           "maxItems": 2
          },
          "prop": {
           "type": "object",
           "required": [
            "id"
           ],
           "properties": {
            "id": {
             "type": "string",
             "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "state": {
             "enum": [
              "normal",
              "broken",
              "glow",
              "small"
             ]
            }
           },
           "additionalProperties": false
          },
          "chart": {
           "type": "object",
           "required": [
            "type",
            "series",
            "x"
           ],
           "properties": {
            "type": {
             "enum": [
              "line",
              "bar",
              "area"
             ]
            },
            "x": {
             "type": "array",
             "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
             },
             "minItems": 2,
             "maxItems": 8
            },
            "unit": {
             "type": "string",
             "minLength": 1,
             "maxLength": 8
            },
            "max": {
             "type": "number"
            },
            "series": {
             "type": "array",
             "items": {
              "type": "object",
              "required": [
               "name",
               "values"
              ],
              "properties": {
               "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 18
               },
               "role": {
                "enum": [
                 "primary",
                 "secondary",
                 "highlight",
                 "ink"
                ]
               },
               "values": {
                "type": "array",
                "items": {
                 "type": "number"
                },
                "minItems": 2,
                "maxItems": 8
               }
              },
              "additionalProperties": false
             },
             "minItems": 1,
             "maxItems": 3
            },
            "annot": {
             "type": "object",
             "required": [
              "at",
              "text"
             ],
             "properties": {
              "at": {
               "type": "integer",
               "minimum": 0
              },
              "series": {
               "type": "integer",
               "minimum": 0
              },
              "text": {
               "type": "string",
               "minLength": 1,
               "maxLength": 18
              }
             },
             "additionalProperties": false
            }
           },
           "additionalProperties": false
          },
          "sides": {
           "type": "array",
           "items": {
            "type": "object",
            "required": [
             "label"
            ],
            "properties": {
             "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18
             },
             "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10
             },
             "prop": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
             },
             "cast": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
             },
             "pose": {
              "enum": [
               "idle",
               "point",
               "walk",
               "cheer",
               "slump",
               "think",
               "shrug",
               "run",
               "hold",
               "fall",
               "reach"
              ]
             },
             "expr": {
              "enum": [
               "neutral",
               "happy",
               "worried",
               "shocked",
               "smug",
               "sad",
               "angry"
              ]
             },
             "win": {
              "type": "boolean"
             }
            },
            "additionalProperties": false
           },
           "minItems": 2,
           "maxItems": 2
          },
          "quote": {
           "type": "object",
           "required": [
            "text"
           ],
           "properties": {
            "text": {
             "type": "string",
             "minLength": 1,
             "maxLength": 140
            },
            "by": {
             "type": "string",
             "minLength": 1,
             "maxLength": 40
            }
           },
           "additionalProperties": false
          },
          "points": {
           "type": "array",
           "items": {
            "type": "object",
            "required": [
             "when",
             "what"
            ],
            "properties": {
             "when": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12
             },
             "what": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
             },
             "hot": {
              "type": "boolean"
             }
            },
            "additionalProperties": false
           },
           "minItems": 2,
           "maxItems": 5
          },
          "items": {
           "type": "array",
           "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
           },
           "minItems": 2,
           "maxItems": 5
          },
          "media": {
           "type": "string",
           "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
         },
         "additionalProperties": false
        },
        "captions": {
         "type": "array",
         "description": "Caption chunks, 5 words at most each (schema-enforced).",
         "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\s*\\S+(\\s+\\S+){0,4}\\s*$"
         }
        },
        "transition": {
         "type": "object",
         "required": [
          "id",
          "easing"
         ],
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "easing": {
           "type": "string",
           "pattern": "^[a-z0-9][a-z0-9-]*$",
           "description": "A named easing from the design system or the built-in list. Never linear."
          }
         },
         "additionalProperties": false
        },
        "beats": {
         "type": "array",
         "description": "Visual events inside the panel. at and duration are seconds from the panel start.",
         "items": {
          "type": "object",
          "required": [
           "at",
           "kind",
           "easing"
          ],
          "properties": {
           "at": {
            "type": "number",
            "minimum": 0
           },
           "duration": {
            "type": "number",
            "exclusiveMinimum": 0
           },
           "kind": {
            "enum": [
             "enter",
             "exit",
             "move",
             "scale",
             "swap",
             "camera",
             "reveal",
             "count",
             "emphasis"
            ]
           },
           "easing": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "A named easing from the design system or the built-in list. Never linear."
           },
           "target": {
            "type": "string"
           }
          },
          "additionalProperties": false
         }
        },
        "widgets": {
         "type": "array",
         "description": "Diegetic micro-widgets. anchor is a frame edge or @<box id>.",
         "items": {
          "type": "object",
          "required": [
           "id",
           "anchor",
           "easing"
          ],
          "properties": {
           "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "A widget id from library/widgets.json (the 50 built components)."
           },
           "anchor": {
            "type": "string",
            "pattern": "^(tl|t|tr|l|r|bl|b|br|@[a-z0-9][a-z0-9-]*)$"
           },
           "at": {
            "type": "number",
            "minimum": 0
           },
           "easing": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "A named easing from the design system or the built-in list. Never linear."
           },
           "props": {
            "type": "object"
           },
           "x": {
            "type": "number",
            "minimum": 6,
            "maximum": 100
           },
           "y": {
            "type": "number",
            "minimum": 8,
            "maximum": 100
           },
           "w": {
            "type": "number",
            "minimum": 0,
            "maximum": 79
           },
           "h": {
            "type": "number",
            "minimum": 0,
            "maximum": 72
           },
           "text": {
            "type": "string"
           },
           "lines": {
            "type": "array",
            "items": {
             "type": "string"
            }
           },
           "role": {
            "enum": [
             "display",
             "body",
             "label",
             "caption"
            ]
           },
           "px": {
            "type": "number",
            "exclusiveMinimum": 0
           },
           "color": {
            "type": "string"
           },
           "bg": {
            "type": "string"
           },
           "font": {
            "type": "string"
           },
           "from": {
            "type": "number",
            "minimum": 0
           },
           "to": {
            "type": "number",
            "minimum": 0
           }
          },
          "additionalProperties": false,
          "description": "Diegetic micro-widget. anchor is a safe-rectangle edge or @<box id>. A box (x, y, w, h) rests inside x 6..85, y 8..80."
         }
        },
        "boxes": {
         "type": "array",
         "description": "Where things sit, in percent of the frame from the top-left. Read by check-safezones.js and check-ai-tells.js.",
         "items": {
          "type": "object",
          "required": [
           "id",
           "kind",
           "x",
           "y",
           "w",
           "h"
          ],
          "properties": {
           "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
           },
           "kind": {
            "enum": [
             "text",
             "caption",
             "face",
             "card",
             "widget",
             "subject",
             "decor"
            ]
           },
           "anchor": {
            "type": "string"
           },
           "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
           },
           "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
           },
           "w": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
           },
           "h": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
           },
           "text": {
            "type": "string"
           },
           "lines": {
            "type": "array",
            "items": {
             "type": "string"
            }
           },
           "role": {
            "enum": [
             "display",
             "body",
             "label",
             "caption"
            ]
           },
           "px": {
            "type": "number",
            "exclusiveMinimum": 0
           },
           "color": {
            "type": "string"
           },
           "bg": {
            "type": "string"
           },
           "font": {
            "type": "string"
           },
           "from": {
            "type": "number",
            "minimum": 0
           },
           "to": {
            "type": "number",
            "minimum": 0
           }
          },
          "additionalProperties": false
         }
        },
        "sfx": {
         "type": "array",
         "description": "Sound cues. at is seconds from the panel start and must sit on a cut, beat, widget or effect start.",
         "items": {
          "type": "object",
          "required": [
           "id"
          ],
          "properties": {
           "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
           },
           "at": {
            "type": "number",
            "minimum": 0
           },
           "frame": {
            "type": "integer",
            "minimum": 0
           }
          },
          "additionalProperties": false
         }
        },
        "bespoke": {
         "type": "array",
         "description": "Bespoke scenes coded for this topic (components/bespoke/<topic>/). Same box and anchor rules as a widget.",
         "items": {
          "type": "object",
          "required": [
           "id",
           "anchor",
           "easing",
           "x",
           "y",
           "w",
           "h",
           "proves"
          ],
          "additionalProperties": false,
          "properties": {
           "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$",
            "description": "A bespoke scene id <topic>/<scene> registered in components/bespoke/registry.ts."
           },
           "anchor": {
            "type": "string",
            "pattern": "^(tl|t|tr|l|r|bl|b|br|@[a-z0-9][a-z0-9-]*)$"
           },
           "at": {
            "type": "number",
            "minimum": 0
           },
           "easing": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
           },
           "props": {
            "type": "object"
           },
           "x": {
            "type": "number",
            "minimum": 6,
            "maximum": 85
           },
           "y": {
            "type": "number",
            "minimum": 8,
            "maximum": 80
           },
           "w": {
            "type": "number",
            "minimum": 1,
            "maximum": 79
           },
           "h": {
            "type": "number",
            "minimum": 1,
            "maximum": 72
           },
           "proves": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "description": "The story beat this scene proves, in plain words."
           },
           "kind": {
            "enum": [
             "svg-diagram",
             "metaphor",
             "kinetic-type",
             "three-d"
            ]
           }
          }
         }
        }
       },
       "additionalProperties": false
      },
      "minItems": 1
     }
    },
    "additionalProperties": false
   },
   "minItems": 1
  }
 },
 "additionalProperties": false,
 "title": "storyboard",
 "description": "Renderable panels: a closed layout plus typed slots. No prose shot descriptions."
}
