{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "title",
  "scenes"
 ],
 "properties": {
  "title": {
   "type": "string",
   "minLength": 1,
   "maxLength": 120
  },
  "scenes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "start",
     "duration",
     "narration",
     "on_screen_text",
     "visual_intent",
     "emotion",
     "facts"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^s[0-9]+$"
     },
     "start": {
      "type": "number",
      "minimum": 0
     },
     "duration": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "narration": {
      "type": "string",
      "description": "Spoken words, or the caption text when there is no voiceover."
     },
     "on_screen_text": {
      "type": "string",
      "maxLength": 120
     },
     "visual_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "emotion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
     },
     "beat": {
      "enum": [
       "hook",
       "setup",
       "turn",
       "payoff",
       "close"
      ]
     },
     "facts": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "claim",
        "status",
        "source"
       ],
       "properties": {
        "claim": {
         "type": "string",
         "minLength": 1,
         "maxLength": 300
        },
        "status": {
         "enum": [
          "verified",
          "VERIFY"
         ]
        },
        "source": {
         "type": "string",
         "description": "URL or citation. Empty only when status is VERIFY."
        }
       },
       "additionalProperties": false
      }
     },
     "rehook": {
      "type": "boolean"
     },
     "captions": {
      "type": "array",
      "minItems": 1,
      "description": "Every narration word in chunks of 5 words or fewer: [from_frame, to_frame, text, power word?]. Frames from the film start.",
      "items": {
       "type": "array",
       "minItems": 3,
       "maxItems": 4,
       "prefixItems": [
        {
         "type": "integer",
         "minimum": 0
        },
        {
         "type": "integer",
         "minimum": 1
        },
        {
         "type": "string",
         "pattern": "^\\s*\\S+(\\s+\\S+){0,4}\\s*$"
        },
        {
         "type": "string",
         "pattern": "^\\S+$"
        }
       ],
       "items": false
      }
     },
     "angle": {
      "type": "string",
      "pattern": "^a[0-9]+$",
      "description": "The id of the winning angle in work/angles.json this scene is built from."
     },
     "visualMetaphor": {
      "type": "string",
      "minLength": 8,
      "maxLength": 300,
      "description": "Iteration 5: the concrete picture the Art Director builds for this beat (a bespoke diagram or metaphor, never a generic icon)."
     },
     "explainer": {
      "type": "boolean",
      "description": "Iteration 3: the one 5 to 7 s concept micro-explainer beat, early in Act 1."
     },
     "impact": {
      "type": "boolean",
      "description": "A major reveal: the sound bed fires a 55 Hz sub-bass hit on the scene's first word after its pause."
     }
    },
    "additionalProperties": false
   },
   "minItems": 1
  },
  "fps": {
   "type": "integer",
   "minimum": 1,
   "maximum": 60
  },
  "hook": {
   "type": "object",
   "required": [
    "formula",
    "belief"
   ],
   "properties": {
    "formula": {
     "enum": [
      "assumption-flip",
      "paradox",
      "binary-question"
     ]
    },
    "belief": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "gap": {
     "type": "string",
     "maxLength": 200
    }
   },
   "additionalProperties": false,
   "description": "personas/scriptwriter.md section 2. The first line flips this belief inside 3 seconds."
  }
 },
 "additionalProperties": false,
 "title": "script"
}
