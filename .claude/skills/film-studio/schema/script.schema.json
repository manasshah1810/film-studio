{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "title",
  "scenes"
 ],
 "properties": {
  "title": {
   "type": "string",
   "minLength": 1,
   "maxLength": 120
  },
  "scenes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "start",
     "duration",
     "narration",
     "on_screen_text",
     "visual_intent",
     "emotion",
     "facts"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^s[0-9]+$"
     },
     "start": {
      "type": "number",
      "minimum": 0
     },
     "duration": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "narration": {
      "type": "string",
      "description": "Spoken words, or the caption text when there is no voiceover."
     },
     "on_screen_text": {
      "type": "string",
      "maxLength": 120
     },
     "visual_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "emotion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
     },
     "beat": {
      "enum": [
       "hook",
       "setup",
       "turn",
       "payoff",
       "close"
      ]
     },
     "facts": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "claim",
        "status",
        "source"
       ],
       "properties": {
        "claim": {
         "type": "string",
         "minLength": 1,
         "maxLength": 300
        },
        "status": {
         "enum": [
          "verified",
          "VERIFY"
         ]
        },
        "source": {
         "type": "string",
         "description": "URL or citation. Empty only when status is VERIFY."
        }
       },
       "additionalProperties": false
      }
     },
     "rehook": {
      "type": "boolean",
      "description": "True when this scene opens a new question. One every 8 to 10 seconds."
     },
     "captions": {
      "type": "array",
      "minItems": 1,
      "description": "Caption chunks: [from_frame, to_frame, text, power_word]. Frames count from the start of the film. Text is at most 5 words; the chunks joined give the narration.",
      "items": {
       "type": "array",
       "minItems": 3,
       "maxItems": 4,
       "prefixItems": [
        {
         "type": "integer",
         "minimum": 0
        },
        {
         "type": "integer",
         "minimum": 1
        },
        {
         "type": "string",
         "minLength": 1
        },
        {
         "type": "string",
         "minLength": 1
        }
       ],
       "items": false
      }
     }
    },
    "additionalProperties": false
   },
   "minItems": 1
  },
  "fps": {
   "type": "integer",
   "minimum": 12,
   "maximum": 60,
   "description": "Frame rate the caption frames are counted in. Default 30."
  },
  "hook": {
   "type": "object",
   "required": [
    "formula",
    "belief",
    "gap"
   ],
   "additionalProperties": false,
   "properties": {
    "formula": {
     "enum": [
      "assumption-flip",
      "paradox",
      "binary-question"
     ]
    },
    "belief": {
     "type": "string",
     "minLength": 5,
     "maxLength": 160,
     "description": "What the viewer assumes before the film."
    },
    "gap": {
     "type": "string",
     "minLength": 5,
     "maxLength": 160,
     "description": "The open question the film must close."
    }
   }
  }
 },
 "additionalProperties": false,
 "title": "script"
}
