{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "scenes"
 ],
 "properties": {
  "scenes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "effects"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^s[0-9]+$"
     },
     "effects": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "panel_id",
        "effect_id",
        "start",
        "duration",
        "reason"
       ],
       "properties": {
        "panel_id": {
         "type": "string",
         "pattern": "^s[0-9]+p[0-9]+$"
        },
        "effect_id": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "start": {
         "type": "number",
         "minimum": 0,
         "description": "Seconds from the start of the panel."
        },
        "duration": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "params": {
         "type": "object"
        },
        "merged_with": {
         "type": "array",
         "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
         },
         "maxItems": 2
        },
        "reason": {
         "type": "string",
         "minLength": 1,
         "maxLength": 200
        },
        "optional": {
         "type": "boolean"
        },
        "easing": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9-]*$",
         "description": "A named easing from the design system or the built-in list. Never linear."
        }
       },
       "additionalProperties": false
      }
     }
    },
    "additionalProperties": false
   }
  },
  "sfx": {
   "type": "array",
   "description": "Sound cues by absolute frame.",
   "items": {
    "type": "object",
    "required": [
     "id",
     "frame"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     },
     "frame": {
      "type": "integer",
      "minimum": 0
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false,
 "title": "vfx-plan"
}
