 "captions": [
  {
   "from": 0,
   "to": 44,
   "text": "Four billion dollars",
   "power": "billion"
  },
  {
   "from": 44,
   "to": 64,
   "text": "for a coin"
  },
  {
   "from": 64,
   "to": 105,
   "text": "that never existed?",
   "power": "never"
  },
  {
   "from": 105,
   "to": 152,
   "text": "OneCoin took that much",
   "power": "OneCoin"
  },
  {
   "from": 152,
   "to": 208,
   "text": "from victims worldwide.",
   "power": "worldwide"
  },
  {
   "from": 208,
   "to": 236,
   "text": "Bitcoin runs"
  },
  {
   "from": 236,
   "to": 276,
   "text": "on a public ledger.",
   "power": "public"
  },
  {
   "from": 276,
   "to": 319,
   "text": "Many computers hold"
  },
  {
   "from": 319,
   "to": 349,
   "text": "the same copy,",
   "power": "same"
  },
  {
   "from": 349,
   "to": 384,
   "text": "so a fake balance"
  },
  {
   "from": 384,
   "to": 421,
   "text": "gets rejected.",
   "power": "rejected"
  },
  {
   "from": 421,
   "to": 458,
   "text": "OneCoin kept"
  },
  {
   "from": 458,
   "to": 541,
   "text": "its ledger private."
  },
  {
   "from": 541,
   "to": 579,
   "text": "Prosecutors say"
  },
  {
   "from": 579,
   "to": 598,
   "text": "it had no"
  },
  {
   "from": 598,
   "to": 639,
   "text": "true blockchain,",
   "power": "true"
  },
  {
   "from": 639,
   "to": 671,
   "text": "and its bosses"
  },
  {
   "from": 671,
   "to": 709,
   "text": "handed out coins"
  },
  {
   "from": 709,
   "to": 766,
   "text": "that existed nowhere.",
   "power": "nowhere"
  },
  {
   "from": 766,
   "to": 803,
   "text": "So who sold it?",
   "power": "who"
  },
  {
   "from": 803,
   "to": 842,
   "text": "Ruja Ignatova."
  },
  {
   "from": 842,
   "to": 894,
   "text": "The press called her"
  },
  {
   "from": 894,
   "to": 940,
   "text": "the Cryptoqueen.",
   "power": "Cryptoqueen"
  },
  {
   "from": 940,
   "to": 979,
   "text": "In 2016 she took"
  },
  {
   "from": 979,
   "to": 1004,
   "text": "the stage",
   "power": "stage"
  },
  {
   "from": 1004,
   "to": 1046,
   "text": "at Wembley Arena"
  },
  {
   "from": 1046,
   "to": 1095,
   "text": "and called OneCoin"
  },
  {
   "from": 1095,
   "to": 1152,
   "text": "the bitcoin killer.",
   "power": "killer"
  },
  {
   "from": 1152,
   "to": 1202,
   "text": "A stage only sells"
  },
  {
   "from": 1202,
   "to": 1231,
   "text": "one crowd,",
   "power": "one"
  },
  {
   "from": 1231,
   "to": 1274,
   "text": "so OneCoin paid"
  },
  {
   "from": 1274,
   "to": 1337,
   "text": "its members to recruit",
   "power": "recruit"
  },
  {
   "from": 1337,
   "to": 1388,
   "text": "new buyers."
  },
  {
   "from": 1388,
   "to": 1418,
   "text": "The coin was"
  },
  {
   "from": 1418,
   "to": 1449,
   "text": "the excuse.",
   "power": "excuse"
  },
  {
   "from": 1449,
   "to": 1479,
   "text": "The recruit"
  },
  {
   "from": 1479,
   "to": 1527,
   "text": "was the product.",
   "power": "product"
  },
  {
   "from": 1527,
   "to": 1567,
   "text": "Here's the catch.",
   "power": "catch"
  },
  {
   "from": 1567,
   "to": 1610,
   "text": "Nobody could check",
   "power": "check"
  },
  {
   "from": 1610,
   "to": 1651,
   "text": "OneCoin's books."
  },
  {
   "from": 1651,
   "to": 1691,
   "text": "So buyers trusted"
  },
  {
   "from": 1691,
   "to": 1742,
   "text": "the friend who sold it,",
   "power": "friend"
  },
  {
   "from": 1742,
   "to": 1777,
   "text": "and that friend"
  },
  {
   "from": 1777,
   "to": 1833,
   "text": "was paid to be trusted.",
   "power": "paid"
  },
  {
   "from": 1833,
   "to": 1892,
   "text": "Then in October 2017,"
  },
  {
   "from": 1892,
   "to": 1929,
   "text": "Ruja boarded"
  },
  {
   "from": 1929,
   "to": 1978,
   "text": "a flight to Athens"
  },
  {
   "from": 1978,
   "to": 2045,
   "text": "and vanished.",
   "power": "vanished"
  },
  {
   "from": 2045,
   "to": 2094,
   "text": "What her buyers held"
  },
  {
   "from": 2094,
   "to": 2123,
   "text": "was a number",
   "power": "number"
  },
  {
   "from": 2123,
